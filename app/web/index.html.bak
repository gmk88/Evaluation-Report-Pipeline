<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>预评价编制工作台</title>
<!-- 浏览器标签上的小图标：和桌面图标一样（app/desktop/icon.icns），内嵌在页面里，不用另外请求 -->
<link rel="icon" type="image/png" href="data:image/png;base64,">
<style>
:root {
  --bg: #f3f5f8; --card: #ffffff; --line: #e1e5eb; --line2: #c9d0d8; --text: #1d2228; --muted: #5f6873; --faint: #8a939d;
  --main: #1f6feb; --main-dark: #1859c4; --main-soft: #e8f0fe;
  --ok: #1a7f37; --ok-soft: #e4f5e9; --warn: #8a5a00; --warn-soft: #fff4d6; --bad: #c62828; --bad-soft: #fdeaea;
  --del: #fde2e2; --del-text: #9b1c1c; --ins: #dcf5e3; --ins-text: #12632b;
  --radius: 14px; --shadow: 0 1px 2px rgba(16,24,40,.05), 0 2px 8px rgba(16,24,40,.04);
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-size: 17px; line-height: 1.65;
  font-family: "PingFang SC", "Microsoft YaHei", "Hiragino Sans GB", "Noto Sans CJK SC", sans-serif; }
svg.i { width: 20px; height: 20px; flex: none; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; vertical-align: -4px; }
header { background: var(--card); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 5; }
.hbar { max-width: 1320px; margin: 0 auto; padding: 10px 24px; display: flex; align-items: center; gap: 14px 24px; flex-wrap: wrap; }
.brand { display: flex; align-items: center; gap: 10px; font-size: 21px; font-weight: 700; cursor: pointer; }
.brand .logo { width: 34px; height: 34px; border-radius: 9px; background: var(--main); color: #fff; display: grid; place-items: center; font-size: 19px; }
nav { display: flex; gap: 4px; margin-left: auto; align-items: center; }
nav button { font-size: 17px; padding: 7px 16px; border: 0; border-radius: 9px; background: transparent; color: var(--text); cursor: pointer; display: inline-flex; gap: 6px; align-items: center; }
nav button:hover { background: var(--main-soft); }
nav button.on { background: var(--main-soft); color: var(--main-dark); font-weight: 600; }
#conn { font-size: 15px; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
#conn .dot { width: 9px; height: 9px; border-radius: 50%; background: #aaa; }
#conn.ok .dot { background: var(--ok); } #conn.bad .dot { background: var(--bad); } #conn.bad { color: var(--bad); }
main { max-width: 1320px; margin: 0 auto; padding: 22px 24px 70px; }
section.page { display: none; } section.page.on { display: block; }
h2 { font-size: 23px; margin: 4px 0 6px; } h3 { font-size: 19px; margin: 22px 0 10px; }
.lead { color: var(--muted); margin: 0 0 18px; }
.muted { color: var(--muted); } .faint { color: var(--faint); } .note { color: var(--muted); font-size: 15px; }
.card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px; box-shadow: var(--shadow); }
button, .btn { font: inherit; font-size: 16px; padding: 8px 16px; border-radius: 10px; border: 1px solid var(--line2);
  background: #fff; color: var(--text); cursor: pointer; display: inline-flex; align-items: center; gap: 7px; line-height: 1.4; }
button:hover { background: #f5f8fc; border-color: #aeb8c4; }
button:focus-visible, a:focus-visible, [tabindex]:focus-visible { outline: 3px solid #9cc0ff; outline-offset: 2px; }
button:disabled { opacity: .5; cursor: default; }
button.main { background: var(--main); border-color: var(--main); color: #fff; font-weight: 600; }
button.main:hover { background: var(--main-dark); }
button.big { font-size: 18px; padding: 12px 22px; border-radius: 12px; }
button.ghost { border-color: transparent; background: transparent; color: var(--main-dark); }
button.ghost:hover { background: var(--main-soft); }
button.danger { color: var(--bad); border-color: #eab0b0; }
button.small { font-size: 15px; padding: 4px 11px; border-radius: 8px; }
.row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.row > input { flex: 1 1 220px; min-width: 0; width: auto; }
.spacer { flex: 1; }
/* 状态：颜色＋文字 */
.pill { display: inline-flex; align-items: center; gap: 6px; padding: 2px 11px; border-radius: 999px; font-size: 15px; white-space: nowrap; background: #eef1f4; color: var(--muted); }
.pill::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
.pill.ok { background: var(--ok-soft); color: var(--ok); } .pill.run { background: var(--main-soft); color: var(--main-dark); }
.pill.warn { background: var(--warn-soft); color: var(--warn); } .pill.bad { background: var(--bad-soft); color: var(--bad); }
.pill.run::before { animation: blink 1.2s infinite; }
@keyframes blink { 50% { opacity: .25; } }
/* 首页卡片 */
.homebar { display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 16px; }
.pcard { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 20px 16px; box-shadow: var(--shadow);
  cursor: pointer; display: flex; flex-direction: column; gap: 10px; transition: border-color .15s, box-shadow .15s; }
.pcard:hover { border-color: #9cc0ff; box-shadow: 0 4px 16px rgba(31,111,235,.10); }
.pcard .t { font-size: 19px; font-weight: 700; line-height: 1.4; }
.pcard .meta { display: flex; gap: 8px 14px; flex-wrap: wrap; font-size: 15px; color: var(--muted); }
.pcard .say { font-size: 16px; }
.pcard .foot { display: flex; gap: 8px; align-items: center; margin-top: 2px; }
.chips { display: flex; gap: 5px; flex-wrap: wrap; }
.chip { min-width: 30px; height: 26px; padding: 0 6px; border-radius: 7px; border: 1.5px solid var(--line2); color: var(--faint);
  font-size: 13px; display: grid; place-items: center; font-variant-numeric: tabular-nums; background: #fff; }
.chip.done { background: var(--ok-soft); border-color: #9fd6ae; color: var(--ok); }
.chip.err { background: var(--bad-soft); border-color: #eeaaaa; color: var(--bad); }
.chip.run { background: var(--main-soft); border-color: #9cc0ff; color: var(--main-dark); animation: blink 1.2s infinite; }
.newcard { border: 2px dashed #a9c4f5; background: #f7faff; color: var(--main-dark); align-items: center; justify-content: center; min-height: 190px; font-size: 18px; font-weight: 600; text-align: center; }
.newcard:hover { background: var(--main-soft); }
.newcard svg.i { width: 34px; height: 34px; }
/* 报告页 */
.crumb { margin-bottom: 10px; }
.phead { display: flex; gap: 14px 20px; align-items: flex-start; flex-wrap: wrap; margin-bottom: 16px; }
.phead .ttl { flex: 1 1 380px; min-width: 0; }
.phead h2 { margin: 0 0 6px; line-height: 1.35; }
.acts { display: flex; gap: 8px; flex-wrap: wrap; }
.stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
.stat { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 16px; }
.stat .n { font-size: 26px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.3; }
.stat .l { color: var(--muted); font-size: 15px; }
.stat.bad .n { color: var(--bad); } .stat.ok .n { color: var(--ok); } .stat.warn .n { color: var(--warn); }
.layout { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 16px; align-items: start; }
.toc { position: sticky; top: 76px; max-height: calc(100vh - 96px); overflow-y: auto; padding: 8px; }
.toc .h { font-size: 15px; color: var(--muted); padding: 6px 10px 4px; }
.toc button { width: 100%; text-align: left; border: 0; border-radius: 9px; padding: 8px 10px; display: flex; gap: 10px; align-items: flex-start; background: transparent; font-size: 16px; }
.toc button:hover { background: #f3f6fa; }
.toc button.on { background: var(--main-soft); }
.toc .no { flex: none; width: 34px; height: 24px; border-radius: 6px; font-size: 13px; display: grid; place-items: center; border: 1.5px solid var(--line2); color: var(--faint); margin-top: 1px; }
.toc .no.done { background: var(--ok-soft); border-color: #9fd6ae; color: var(--ok); }
.toc .no.err { background: var(--bad-soft); border-color: #eeaaaa; color: var(--bad); }
.toc .nm { flex: 1; min-width: 0; line-height: 1.4; }
.toc .sub { display: block; font-size: 13px; color: var(--faint); margin-top: 2px; }
.toc .sub.bad { color: var(--bad); }
.tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--line); margin: -4px -4px 14px; padding: 0 4px; flex-wrap: wrap; }
.tabs button { border: 0; border-bottom: 3px solid transparent; border-radius: 0; background: transparent; padding: 10px 14px; font-size: 17px; color: var(--muted); }
.tabs button:hover { background: transparent; color: var(--text); }
.tabs button.on { color: var(--main-dark); border-bottom-color: var(--main); font-weight: 600; }
.tabs .cnt { font-size: 13px; background: #eef1f4; color: var(--muted); border-radius: 999px; padding: 0 8px; }
.tabs .cnt.bad { background: var(--bad-soft); color: var(--bad); }
/* 正文 */
.doc { font-size: 17px; line-height: 1.85; max-width: 920px; }
.doc .ln { position: relative; padding: 1px 8px 1px 52px; border-radius: 6px; scroll-margin-top: 120px; }
.doc .ln .num { position: absolute; left: 0; width: 42px; text-align: right; color: #b5bcc4; font-size: 12px; top: .35em; user-select: none; font-variant-numeric: tabular-nums; }
.doc .ln.flag { background: var(--warn-soft); }
.doc .ln.flagbad { background: var(--bad-soft); }
.doc .ln.hit { outline: 2px solid var(--main); }
.doc .ln .why { display: block; font-size: 14px; color: var(--bad); margin-top: 2px; }
.doc .ln .why.w { color: var(--warn); }
.doc h1, .doc h2, .doc h3, .doc h4 { margin: 14px 0 4px; line-height: 1.45; }
.doc h1 { font-size: 23px; } .doc h2 { font-size: 20px; } .doc h3 { font-size: 18px; } .doc h4 { font-size: 17px; }
.doc .tbl { overflow-x: auto; margin: 6px 0; }
.doc table { border-collapse: collapse; font-size: 15px; line-height: 1.5; }
.doc td, .doc th { border: 1px solid var(--line2); padding: 4px 8px; vertical-align: top; }
.doc th { background: #f3f5f8; }
.doc .cap { text-align: center; font-weight: 600; }
.doc .cmt { color: var(--faint); font-size: 14px; }
.doc .img { color: var(--muted); font-size: 15px; }
/* 问题、改动 */
.group { margin-bottom: 22px; }
.group > .gh { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; font-weight: 700; font-size: 18px; }
.issue { display: flex; gap: 12px; align-items: flex-start; padding: 11px 14px; border: 1px solid var(--line); border-radius: 11px; margin-bottom: 8px; background: #fff; }
.issue .where { flex: none; font-size: 14px; color: var(--muted); min-width: 120px; }
.issue .what { flex: 1; min-width: 0; word-break: break-word; }
.issue.bad { border-left: 4px solid var(--bad); } .issue.warn { border-left: 4px solid #e0b040; } .issue.todo { border-left: 4px solid #b9c0c8; }
.change { border: 1px solid var(--line); border-radius: 12px; margin-bottom: 12px; overflow: hidden; background: #fff; }
.change .ch { display: flex; gap: 10px; align-items: center; padding: 9px 14px; background: #f7f9fb; border-bottom: 1px solid var(--line); flex-wrap: wrap; font-size: 15px; }
.change .cb { padding: 10px 14px; }
.change .why { font-size: 15px; color: var(--muted); margin-top: 8px; }
.change .why b { color: var(--text); font-weight: 600; }
.diff { white-space: pre-wrap; word-break: break-word; line-height: 1.8; }
.diff del { background: var(--del); color: var(--del-text); text-decoration: line-through; text-decoration-color: rgba(155,28,28,.5); border-radius: 3px; }
.diff ins { background: var(--ins); color: var(--ins-text); text-decoration: none; border-radius: 3px; }
.two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.two > div { border-radius: 8px; padding: 8px 10px; white-space: pre-wrap; word-break: break-word; font-size: 16px; }
.two .o { background: #fbf3f3; } .two .n { background: #f2faf4; }
.two .lab { display: block; font-size: 13px; color: var(--muted); margin-bottom: 2px; }
.filter { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; align-items: center; }
.filter button.on { background: var(--main-soft); border-color: #9cc0ff; color: var(--main-dark); }
/* 进度条 */
.live { border: 1px solid #b9d1fb; background: #f6f9ff; border-radius: var(--radius); padding: 16px 20px; margin-bottom: 16px; }
.live.fail { border-color: #eeb5b5; background: #fff7f7; }
.live.done { border-color: #a9dbb6; background: #f6fcf8; }
.live .top { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.live .top .what { font-size: 18px; font-weight: 700; }
.steps { display: flex; margin: 16px 0 6px; gap: 0; }
.steps .s { flex: 1; text-align: center; position: relative; font-size: 14px; color: var(--faint); padding-top: 34px; min-width: 0; }
.steps .s::before { content: ""; position: absolute; top: 12px; left: 0; right: 0; height: 3px; background: var(--line); }
.steps .s:first-child::before { left: 50%; } .steps .s:last-child::before { right: 50%; }
.steps .s .b { position: absolute; top: 2px; left: 50%; transform: translateX(-50%); width: 24px; height: 24px; border-radius: 50%; background: #fff;
  border: 3px solid var(--line2); display: grid; place-items: center; font-size: 12px; font-weight: 700; z-index: 1; }
.steps .s.done { color: var(--ok); } .steps .s.done::before { background: #9fd6ae; } .steps .s.done .b { background: var(--ok); border-color: var(--ok); color: #fff; }
.steps .s.now { color: var(--main-dark); font-weight: 600; } .steps .s.now .b { border-color: var(--main); background: var(--main-soft); animation: blink 1.4s infinite; }
.steps .s.fail { color: var(--bad); font-weight: 600; } .steps .s.fail .b { border-color: var(--bad); background: var(--bad); color: #fff; }
.bar { height: 8px; border-radius: 999px; background: #e3e9f2; overflow: hidden; margin-top: 8px; }
.bar > i { display: block; height: 100%; background: var(--main); border-radius: 999px; transition: width .4s; }
.live .now { margin-top: 8px; font-size: 16px; }
.live .say { margin-top: 10px; white-space: pre-wrap; }
details.more { margin-top: 10px; }
details.more summary { cursor: pointer; color: var(--main-dark); font-size: 15px; }
pre.text { font-family: Menlo, Consolas, "Courier New", monospace; font-size: 14px; white-space: pre-wrap; word-break: break-word;
  background: #fafbfc; border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; margin: 8px 0 0; max-height: 360px; overflow-y: auto; }
table.list { border-collapse: collapse; width: 100%; }
table.list th, table.list td { border-bottom: 1px solid var(--line); padding: 9px 10px; text-align: left; vertical-align: top; }
table.list th { font-weight: 600; color: var(--muted); font-size: 15px; white-space: nowrap; }
table.list td.num, table.list th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
table.list tr.click { cursor: pointer; } table.list tr.click:hover td { background: #f5f8fc; }
.tablewrap { overflow-x: auto; }
/* 表单（分步） */
.wizard { max-width: 860px; }
.wsteps { display: flex; gap: 8px; margin: 6px 0 18px; flex-wrap: wrap; }
.wsteps span { padding: 5px 14px; border-radius: 999px; background: #eef1f4; color: var(--muted); font-size: 15px; }
.wsteps span.on { background: var(--main); color: #fff; } .wsteps span.done { background: var(--ok-soft); color: var(--ok); }
label.f { display: block; font-weight: 600; margin: 16px 0 6px; }
input[type=text], input[type=password], input[type=number], select, textarea {
  font: inherit; font-size: 16px; width: 100%; padding: 9px 12px; border: 1px solid var(--line2); border-radius: 10px; background: #fff; }
input:focus, select:focus, textarea:focus { outline: 3px solid #cfe0ff; border-color: var(--main); }
textarea { min-height: 120px; resize: vertical; line-height: 1.6; }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; }
.choice { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.choice label { display: flex; gap: 10px; align-items: flex-start; border: 1.5px solid var(--line2); border-radius: 12px; padding: 12px 14px; cursor: pointer; font-weight: 400; }
.choice label:has(input:checked) { border-color: var(--main); background: var(--main-soft); }
.choice b { display: block; } .choice small { color: var(--muted); font-size: 14px; }
.checks label { display: inline-flex; align-items: center; gap: 8px; margin: 4px 20px 4px 0; cursor: pointer; }
input[type=checkbox], input[type=radio] { width: 18px; height: 18px; flex: none; margin-top: 3px; }
.drop { border: 2px dashed var(--line2); border-radius: 12px; padding: 18px; text-align: center; color: var(--muted); background: #fafcff; }
.files { margin: 10px 0 0; padding: 0; list-style: none; }
.files li { display: flex; gap: 10px; align-items: center; padding: 7px 10px; border: 1px solid var(--line); border-radius: 9px; margin-bottom: 6px; background: #fff; word-break: break-all; font-size: 15px; }
.files li .spacer { min-width: 8px; }
.chgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 6px 12px; }
.chgrid label { display: flex; gap: 8px; align-items: flex-start; font-size: 15px; cursor: pointer; }
.formbtns { display: flex; gap: 10px; margin-top: 22px; align-items: center; flex-wrap: wrap; }
.msg { margin-top: 12px; padding: 10px 14px; border-radius: 10px; display: none; white-space: pre-wrap; }
.msg.on { display: block; } .msg.err { background: var(--bad-soft); color: var(--bad); } .msg.info { background: var(--main-soft); }
.callout { padding: 12px 14px; border-radius: 10px; background: var(--warn-soft); color: #5c3d00; margin-top: 10px; font-size: 16px; }
.empty { padding: 30px; text-align: center; color: var(--muted); background: var(--card); border: 1px dashed var(--line2); border-radius: var(--radius); }
.kv { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; }
.kv > .k { color: var(--muted); white-space: nowrap; } .kv > .v { word-break: break-all; }
a.link { color: var(--main-dark); text-decoration: underline; cursor: pointer; }
#modal { position: fixed; inset: 0; background: rgba(20, 24, 30, .45); display: none; z-index: 20; align-items: flex-start; justify-content: center; padding: 40px 16px; overflow-y: auto; }
#modal.on { display: flex; }
#modalBox { background: var(--card); border-radius: 14px; width: min(900px, 100%); padding: 20px 24px 24px; box-shadow: 0 10px 40px rgba(0,0,0,.2); }
#modalHead { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 8px; }
#modalHead h2 { margin: 0; font-size: 20px; }
#fatal { display: none; max-width: 760px; margin: 80px auto; padding: 30px; font-size: 20px; text-align: center; background: var(--card); border: 2px solid var(--bad); border-radius: 14px; color: var(--bad); }
body.dead header, body.dead main { display: none; } body.dead #fatal { display: block; }
#toast { position: fixed; right: 20px; bottom: 20px; max-width: 460px; padding: 12px 16px; border-radius: 12px; background: #2b3138; color: #fff; display: none; z-index: 30; white-space: pre-wrap; }
#toast.on { display: block; } #toast.err { background: var(--bad); }
@media (max-width: 980px) { .layout { grid-template-columns: 1fr; } .toc { position: static; max-height: none; } .stats { grid-template-columns: 1fr 1fr; } }
@media (max-width: 680px) {
  .hbar, main { padding-left: 16px; padding-right: 16px; }
  .cards { grid-template-columns: 1fr; } .grid2, .choice, .two { grid-template-columns: 1fr; }
  nav { margin-left: 0; width: 100%; } #conn { display: none; }
  .steps .s { font-size: 12px; } .issue { flex-direction: column; gap: 4px; } .issue .where { min-width: 0; }
  .doc .ln { padding-left: 36px; } .doc .ln .num { width: 28px; }
}
</style>
</head>
<body>
<div id="fatal"></div>
<header>
  <div class="hbar">
    <div class="brand" id="brand" role="link" tabindex="0"><span class="logo">评</span>预评价编制工作台</div>
    <span id="conn"><span class="dot"></span><span id="connText">正在连接…</span></span>
    <nav id="nav">
      <button data-page="home">报告</button>
      <button data-page="history">做过的事</button>
      <button data-page="settings">设置</button>
    </nav>
  </div>
</header>
<main>
  <section class="page" id="page-home"></section>
  <section class="page" id="page-history"></section>
  <section class="page" id="page-settings"></section>
</main>
<div id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div id="modalBox">
    <div id="modalHead"><h2 id="modalTitle"></h2><button id="modalClose" aria-label="关闭">关闭</button></div>
    <div id="modalBody"></div>
  </div>
</div>
<div id="toast" role="status" aria-live="polite"></div>
<script>
/* SCRIPT-START */
'use strict';
// ---------- 小工具：建元素一律用 textContent，不拼外来文字 ----------
function el(tag, attrs, ...kids) {
  const e = document.createElement(tag);
  if (attrs) {
    for (const [k, v] of Object.entries(attrs)) {
      if (v === undefined || v === null || v === false) continue;
      if (k === 'class') e.className = v;
      else if (k === 'text') e.textContent = String(v);
      else if (k.startsWith('on') && typeof v === 'function') e.addEventListener(k.slice(2), v);
      else if (v === true) e.setAttribute(k, '');
      else e.setAttribute(k, String(v));
    }
  }
  for (const c of kids.flat()) {
    if (c === undefined || c === null || c === false) continue;
    e.appendChild(c instanceof Node ? c : document.createTextNode(String(c)));
  }
  return e;
}
function clear(node) { while (node.firstChild) node.removeChild(node.firstChild); return node; }
const $ = (id) => document.getElementById(id);
// 线条小图标（写在页面里，不用另外请求）
const ICONS = {
  plus: 'M12 5v14M5 12h14', back: 'M15 18l-6-6 6-6', folder: 'M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z',
  pdf: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 13h6M9 17h4',
  edit: 'M4 20h4L19 9l-4-4L4 16zM14 6l4 4', search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4',
  play: 'M7 4l12 8-12 8z', stop: 'M6 6h12v12H6z', note: 'M6 3h9l4 4v14H6zM9 12h7M9 16h5',
  file: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5', refresh: 'M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7',
  gear: 'M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6zM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z',
  image: 'M4 5h16v14H4zM4 16l5-5 4 4 3-3 4 4M15 9h.01',
  check: 'M5 12l5 5L20 7', alert: 'M12 3l10 18H2zM12 10v5M12 18h.01', list: 'M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01',
};
const SVGNS = 'http://www.w3.org/2000/svg';
function icon(name) {
  const s = document.createElementNS(SVGNS, 'svg');
  s.setAttribute('class', 'i'); s.setAttribute('viewBox', '0 0 24 24'); s.setAttribute('aria-hidden', 'true');
  const p = document.createElementNS(SVGNS, 'path'); p.setAttribute('d', ICONS[name] || ''); s.appendChild(p);
  return s;
}
function pill(kind, text) { return el('span', { class: 'pill ' + (kind || ''), text: text }); }
function empty(text) { return el('div', { class: 'empty', text: text }); }
function showMsg(box, text, isErr) { box.textContent = text; box.className = 'msg on ' + (isErr ? 'err' : 'info'); }
let toastTimer = 0;
function toast(msg, isErr) {
  const t = $('toast');
  t.textContent = msg;
  t.className = 'on' + (isErr ? ' err' : '');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { t.className = ''; }, isErr ? 7000 : 3000);
}
// ---------- 接口 ----------
class ApiErr extends Error { constructor(code, msg) { super(msg); this.code = code; } }
let DEAD = false;
function die() {
  if (DEAD) return;
  DEAD = true;
  stopTimers();
  $('fatal').textContent = '口令过期：请双击桌面上的“预评价编制工作台”重新打开';
  document.body.classList.add('dead');
}
async function api(path, body, method) {
  if (DEAD) throw new ApiErr(403, '口令过期');
  const opt = { method: method || (body === undefined ? 'GET' : 'POST'), credentials: 'same-origin', cache: 'no-store', headers: {} };
  if (body !== undefined) { opt.headers['Content-Type'] = 'application/json'; opt.body = JSON.stringify(body); }
  let r;
  try { r = await fetch(path, opt); }
  catch (e) { throw new ApiErr(0, '连不上后台服务：请双击桌面上的“预评价编制工作台”'); }
  let d = null;
  try { d = await r.json(); } catch (e) { d = null; }
  // 只有口令不对才整页提示；“这个文件不能打开”之类的 403 照常显示那句话
  if (r.status === 403 && (!d || (typeof d['错误'] === 'string' && d['错误'].indexOf('口令不对') === 0))) { die(); throw new ApiErr(403, '口令过期'); }
  if (!r.ok) {
    const m = d && typeof d['错误'] === 'string' ? d['错误'] : '服务出错了（' + r.status + '）';
    throw new ApiErr(r.status, m);
  }
  if (d === null) throw new ApiErr(r.status, '服务回的内容看不懂');
  return d;
}
const q = (o) => '?' + new URLSearchParams(o);
function errText(e) { return (e && e instanceof ApiErr) ? e.message : '出错了，请刷新页面再试'; }
async function openPath(p) {
  try { await api('/api/open', { '路径': p }); toast('已在电脑上打开'); }
  catch (e) { if (!DEAD) toast(errText(e), true); }
}
async function pick(kind, multi, prompt) {
  try { const d = await api('/api/pick', { '类型': kind, '多选': !!multi, '提示': prompt || '' }); return Array.isArray(d['路径']) ? d['路径'] : []; }
  catch (e) { if (!DEAD) toast(errText(e), true); return []; }
}
let modalOnClose = null;
function openModal(title, body, onClose) {
  $('modalTitle').textContent = title;
  clear($('modalBody')).appendChild(body);
  $('modal').classList.add('on');
  modalOnClose = onClose || null;
  $('modalClose').focus();
}
function closeModal() {
  $('modal').classList.remove('on');
  clear($('modalBody'));
  const f = modalOnClose; modalOnClose = null;
  if (f) f();
}
$('modalClose').addEventListener('click', closeModal);
document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && $('modal').classList.contains('on')) closeModal(); });

// ---------- 格式 ----------
const pad = (n) => String(n).padStart(2, '0');
function fmtTime(t) {
  if (!t) return '';
  const d = new Date(Number(t) * 1000);
  if (isNaN(d.getTime())) return '';
  const now = new Date();
  const hm = pad(d.getHours()) + ':' + pad(d.getMinutes());
  if (d.toDateString() === now.toDateString()) return '今天 ' + hm;
  const y = new Date(now); y.setDate(now.getDate() - 1);
  if (d.toDateString() === y.toDateString()) return '昨天 ' + hm;
  return (d.getFullYear() !== now.getFullYear() ? d.getFullYear() + '年' : '') + (d.getMonth() + 1) + '月' + d.getDate() + '日 ' + hm;
}
function fmtDur(sec) {
  if (sec === null || sec === undefined || isNaN(sec) || sec < 0) return '';
  sec = Math.round(sec);
  if (sec < 60) return sec + ' 秒';
  const m = Math.floor(sec / 60);
  if (m < 60) return m + ' 分钟';
  return Math.floor(m / 60) + ' 小时 ' + (m % 60) + ' 分';
}
function fmtNum(n) { n = Number(n); return isFinite(n) ? n.toLocaleString('zh-CN') : ''; }
const RATE = 7.2;   // 美元换人民币，只是估个大概
function fmtYuan(usd) {
  usd = Number(usd);
  if (!isFinite(usd) || usd <= 0) return '';
  const y = usd * RATE;
  return '约 ¥' + (y >= 100 ? Math.round(y) : y.toFixed(1));
}
function baseName(p) { return String(p || '').replace(/[\\\/]+$/, '').split(/[\\\/]/).pop(); }
function pathLink(p, label) {
  return el('a', { class: 'link', href: '#', title: p, onclick: (e) => { e.preventDefault(); openPath(p); } }, label || p);
}
// 章号：文件名开头的 01、02_3 → “第1章”“2.3”
function chapNo(f) {
  const m = /^(\d{2})(?:_(\d+))?/.exec(f || '');
  if (!m) return '';
  return m[2] ? Number(m[1]) + '.' + Number(m[2]) : String(Number(m[1]));
}
function chapLabel(f) { const m = /^(\d{2})(?:_(\d+))?/.exec(f || ''); return m ? (m[2] ? '第' + Number(m[1]) + '章 第' + Number(m[2]) + '部分' : '第' + Number(m[1]) + '章') : f; }
function chapName(f, title) {
  // 标题里本来就有章节号（“# 4 职业病危害因素……”），去掉号只留名字
  const t = String(title || '').replace(/^[\d.\s]+/, '').trim();
  return t || String(f || '').replace(/^\d{2}(_\d+)?_?/, '').replace(/\.md$/, '');
}
// 检查条目“第38行 ……”拆成行号和说明
function splitLine(s) { const m = /^第(\d+)行\s*(.*)$/.exec(String(s || '')); return m ? { line: Number(m[1]), text: m[2] } : { line: 0, text: String(s || '') }; }
// ---------- 导航：网址 # 后面记住在哪一页，刷新不丢 ----------
// #home  #p/<项目文件夹>/<页签>/<文件>  #job/<号>  #new  #revise/<项目>  #review/<项目>  #history  #settings
let timers = [];
function stopTimers() { timers.forEach(clearTimeout); timers = []; }
function later(fn, ms) { const id = setTimeout(fn, ms); timers.push(id); return id; }
let routeSeq = 0;
const stale = (seq) => seq !== routeSeq || DEAD;
function go(hash) { if (location.hash === '#' + hash) route(); else location.hash = hash; }
function enc(s) { return encodeURIComponent(s); }
function projHash(path, tab, file, line) { return 'p/' + enc(path) + '/' + (tab || 'doc') + (file ? '/' + enc(file) + (line ? '/' + line : '') : ''); }
const PAGE_OF = { home: 'home', p: 'home', job: 'home', new: 'home', revise: 'home', review: 'home', history: 'history', settings: 'settings' };
function route() {
  if (DEAD) return;
  stopTimers();
  routeSeq++;
  const seq = routeSeq;
  const parts = location.hash.replace(/^#/, '').split('/').map((x) => { try { return decodeURIComponent(x); } catch (e) { return ''; } });
  let page = parts[0] || 'home';
  if (!PAGE_OF[page]) page = 'home';
  const sect = PAGE_OF[page];
  document.querySelectorAll('section.page').forEach((s) => s.classList.toggle('on', s.id === 'page-' + sect));
  document.querySelectorAll('#nav button').forEach((b) => b.classList.toggle('on', b.dataset.page === sect));
  const box = clear($('page-' + sect));
  window.scrollTo(0, 0);
  if (page === 'p') showProject(box, seq, parts[1], parts[2] || 'doc', parts[3] || '', Number(parts[4] || 0));
  else if (page === 'job') showJob(box, seq, parts[1]);
  else if (page === 'new') formNew(box, seq);
  else if (page === 'revise') formRevise(box, seq, parts[1] || '', parts.slice(2).join('/'));
  else if (page === 'review') formReview(box, seq, parts[1] || '');
  else if (page === 'history') showHistory(box, seq);
  else if (page === 'settings') showSettings(box, seq);
  else showHome(box, seq);
}
document.querySelectorAll('#nav button').forEach((b) => b.addEventListener('click', () => go(b.dataset.page)));
$('brand').addEventListener('click', () => go('home'));
$('brand').addEventListener('keydown', (e) => { if (e.key === 'Enter') go('home'); });
window.addEventListener('hashchange', route);

// ---------- 连接状态 ----------
let SETTINGS = null;
async function loadSettings() {
  try {
    SETTINGS = await api('/api/settings');
    $('conn').className = SETTINGS['有密钥'] ? 'ok' : 'bad';
    $('connText').textContent = SETTINGS['有密钥'] ? '模型已连上' : '还没填密钥，到“设置”里填';
  } catch (e) {
    if (DEAD) return SETTINGS;
    $('conn').className = 'bad';
    $('connText').textContent = errText(e);
  }
  return SETTINGS;
}
// ---------- 任务说成人话 ----------
const RUNNING = ['进行', '等待', '排队'];
const AGAIN_KINDS = ['新报告', '事实库'];   // 能“接着做”的任务（和网页服务的 AGAIN 一样）
const KIND_NAME = { '新报告': '写新报告', '审稿': '全文审稿', '改稿': '照意见修改', '出稿': '出 PDF', '事实库': '整理项目情况', '提炼标准': '更新写作规矩', '配图': '配图', '自测': '自测' };
function kindName(k) { return KIND_NAME[k] || k || ''; }
function stateView(s) {
  if (s === '进行') return ['run', '正在做'];
  if (s === '等待' || s === '排队') return ['run', '排队中'];
  if (s === '完成') return ['ok', '做完了'];
  if (s === '失败') return ['bad', '出错停了'];
  if (s === '中断') return ['bad', '中途停了'];
  if (s === '已取消') return ['', '已停下'];
  if (s === '跳过') return ['', '跳过'];
  return ['', s || ''];
}
function statePill(s) { const v = stateView(s); return pill(v[0], v[1]); }
// _后来做完：同一份报告后来又做过同一类事并且做完了（比如这次断了，后来已经接着做完），不再让接着做，免得花两遍钱
function canAgain(j) { return AGAIN_KINDS.indexOf(j['类别']) >= 0 && ['失败', '中断', '已取消'].indexOf(j['状态']) >= 0 && !j._后来做完; }
function markLater(j, arr) {
  if (!j || !j['项目'] || !Array.isArray(arr)) return j;
  j._后来做完 = arr.some((x) => x['号'] !== j['号'] && x['项目'] === j['项目'] && x['类别'] === j['类别'] && (x['建立'] || 0) > (j['建立'] || 0) && x['状态'] === '完成');
  return j;
}
// 每类任务的几大步：后台“阶段”对到这几步上
const FLOW = {
  '新报告': [['读资料', ['准备']], ['整理项目情况', ['事实']], ['列岗位和危害因素', ['骨架']], ['逐章写', ['写作']], ['配图', ['配图']], ['自查', ['检查']], ['审稿', ['逐章审', '跨章', '复查']], ['出 PDF', ['出稿']]],
  '审稿': [['准备', ['准备']], ['逐章审', ['逐章审']], ['前后各章对一遍', ['跨章']], ['复查', ['复查']], ['出 PDF', ['出稿']]],
  '改稿': [['理解意见', ['定口径']], ['逐章改', ['修改']], ['复查', ['复查']], ['出 PDF', ['出稿']]],
  '出稿': [['检查', ['检查']], ['生成 Word、转 PDF、逐页核对', ['出稿']]],
  '事实库': [['读资料、整理、核对', ['事实']]],
  '配图': [['画风频玫瑰图、截区域位置图和平面布置图、排工艺流程图', ['配图']]],
  '提炼标准': [['定写作规矩', ['口径']], ['各章要点', ['各章']], ['补漏', ['补漏']]],
};
function stepName(n) {
  n = String(n || '');
  let m;
  if ((m = /^摘事实(?: 第(\d+)批)?/.exec(n))) return '读资料' + (m[1] ? '（第' + m[1] + '批）' : '');
  if (/^汇总事实库/.test(n)) return '整理项目情况';
  if ((m = /^核对事实库(?: 第(\d+)批)?/.exec(n))) return '对照资料核对' + (m[1] ? '（第' + m[1] + '批）' : '') + (/重来/.test(n) ? '，重试' : '');
  if (/^填项目信息/.test(n)) return '读项目基本信息';
  if (/^岗位因素表/.test(n)) return '列岗位和危害因素';
  if ((m = /^写 (\S+\.md)/.exec(n))) return '写' + chapLabel(m[1]) + ' ' + chapName(m[1]);
  if ((m = /^审 (\S+\.md)/.exec(n))) return '审' + chapLabel(m[1]) + ' ' + chapName(m[1]);
  if ((m = /^改 .*?(\d{2}(?:_\d+)?_\S*\.md)/.exec(n))) return '改' + chapLabel(m[1]);
  if (/^跨章一致/.test(n)) return '前后各章对一遍';
  if (/^定口径/.test(n)) return '理解修改意见';
  if (/^出稿/.test(n)) return '生成 Word、转 PDF、逐页核对';
  if (/^配图/.test(n)) return '配图';
  if (/^排工艺流程图（改）/.test(n)) return '排工艺流程图（按检查结果改一遍）';
  if (/^排工艺流程图/.test(n)) return '排工艺流程图';
  return n;
}
// 出错的话：先说怎么回事、怎么办，原话放到“细节”里
function errSay(j) {
  const e = String(j['错误'] || '');
  const again = canAgain(j);
  if (j._后来做完) return '这次中途停了，后来已经接着做完了，不用再管它。';
  const tip = again ? '可以点“接着做”：上次做完的步骤不重做，已经花的钱不白花。' : '可以重新开始这个任务。';
  if (/检查有错误/.test(e)) {
    const n = (/(\d+)\s*条/.exec(e) || [])[1];
    return '正文里还有 ' + (n || '几') + ' 处必须改的问题，所以没有出 PDF。到这份报告的“问题清单”里看是哪几处，改掉再出。';
  }
  if (/中途断了|不是合法 JSON|连不上|Connection|超时|timed out/i.test(e)) return '网络那头中途断了，这一步没做成。' + tip;
  if (j['状态'] === '中断' && !e) return '任务中途停了：程序被关掉或电脑休眠时会这样。' + tip;
  if (j['状态'] === '已取消') return '已经停下了。' + (again ? tip : '');
  return (e || '任务没做完就停了') + '\n' + tip;
}
// ---------- 首页：报告列表 ----------
function byChapter(chapters) {
  // 第2章分几个文件：合成一格
  const out = [];
  for (const c of chapters || []) {
    const k = String(c['文件']).slice(0, 2);
    let g = out.find((x) => x.k === k);
    if (!g) { g = { k, files: [] }; out.push(g); }
    g.files.push(c);
  }
  return out;
}
function runningFiles(job) {
  return (job && Array.isArray(job['进行中']) ? job['进行中'] : []).map((n) => (/(\d{2}(?:_\d+)?_\S*\.md)/.exec(String(n)) || [])[1]).filter(Boolean);
}
function chips(chapters, job) {
  const now = runningFiles(job).map((f) => f.slice(0, 2));
  return el('div', { class: 'chips', 'aria-label': '各章情况' }, byChapter(chapters).map((g) => {
    const errs = g.files.reduce((n, c) => n + (c['错误'] || []).length, 0);
    const done = g.files.every((c) => c['写好']);
    const cls = now.indexOf(g.k) >= 0 ? 'run' : errs ? 'err' : done ? 'done' : '';
    const say = '第' + Number(g.k) + '章：' + (cls === 'run' ? '正在写' : errs ? '有 ' + errs + ' 处必须改' : done ? '写好了' : '还没写');
    return el('span', { class: 'chip ' + cls, title: say, 'aria-label': say, text: Number(g.k) });
  }));
}
function projectSay(p, d, job, last) {
  // 一句话说现在怎样，返回 [颜色, 文字]
  if (job) {
    const doing = (job['进行中'] || []).map(stepName).slice(0, 2).join('、');
    return ['run', '正在' + kindName(job['类别']) + (doing ? '：' + doing : '')];
  }
  if (last && canAgain(last)) return ['bad', '上次' + kindName(last['类别']) + '中途停了，可以接着做'];
  const err = Number((d && d['错误']) ?? p['错误'] ?? 0);
  if (p['存在'] === false) return ['bad', '文件夹找不到了'];
  if (d) {
    const all = d['章节'].length, ok = d['章节'].filter((c) => c['写好']).length;
    if (all && ok < all) return ['warn', '写好 ' + ok + ' / ' + all + ' 个文件'];
  }
  if (err > 0) return ['bad', '有 ' + err + ' 处必须改的问题，改完才能出 PDF'];
  if (p['PDF']) return ['ok', '已出 PDF' + (p['页数'] ? '，' + p['页数'] + ' 页' : '') + '（' + fmtTime(p['PDF时间']) + '）'];
  return ['warn', '正文写好了，还没出 PDF'];
}
function codeOf(name) { return (/(AT-\d{4}-[A-Z]?\d+)/.exec(name || '') || [])[1] || ''; }
function shortName(name) { return String(name || '').replace(/[（(]\s*AT-\d{4}-[A-Z]?\d+\s*[)）]/, '').trim(); }
let PROJECTS = [];
async function loadProjects() {
  const d = await api('/api/overview');
  PROJECTS = Array.isArray(d['项目']) ? d['项目'] : [];
  return PROJECTS;
}
async function showHome(box, seq) {
  box.appendChild(el('div', { class: 'homebar' },
    el('div', { style: 'flex:1;min-width:260px' }, el('h2', { text: '我的报告' }),
      el('p', { class: 'lead', text: '点一份报告进去看各章、问题和改过的地方。小方格是第1～11章：绿色写好了，红色有必须改的问题，蓝色正在写，空心还没写。' })),
    el('button', { class: 'main big', onclick: () => go('new') }, icon('plus'), '写一份新报告')));
  const grid = box.appendChild(el('div', { class: 'cards' }, el('p', { class: 'muted', text: '正在读取，检查正文要几秒钟…' })));
  let jobsArr = [];
  try { [, jobsArr] = await Promise.all([loadProjects(), api('/api/jobs')]); }
  catch (e) { if (!stale(seq)) clear(grid).appendChild(el('p', { class: 'bad', text: errText(e) })); return; }
  if (stale(seq)) return;
  clear(grid);
  const sameRoot = (a, b) => String(a || '').replace(/[\\\/]+$/, '') === String(b || '').replace(/[\\\/]+$/, '');
  for (const p of PROJECTS) {
    const mine = (Array.isArray(jobsArr) ? jobsArr : []).filter((j) => sameRoot(j['项目'], p['文件夹']));
    const job = mine.find((j) => RUNNING.indexOf(j['状态']) >= 0);
    const last = markLater(mine[0], mine);
    const sayBox = el('div', { class: 'say' });
    const chipBox = el('div', { class: 'chips' }, el('span', { class: 'faint', style: 'font-size:14px', text: '读取各章…' }));
    const draw = (d) => { const s = projectSay(p, d, job, last); clear(sayBox).appendChild(pill(s[0], s[1])); };
    draw(null);
    const code = codeOf(p['项目']);
    const open = () => go(projHash(p['文件夹']));
    grid.appendChild(el('div', { class: 'pcard', role: 'link', tabindex: '0', onclick: open, onkeydown: (e) => { if (e.key === 'Enter') open(); } },
      el('div', { class: 't', text: shortName(p['项目']) || baseName(p['文件夹']) }),
      el('div', { class: 'meta' }, code ? el('span', { text: '编号 ' + code }) : null, el('span', { text: p['方法'] || '' }),
        p['正文修改'] ? el('span', { text: '正文改于 ' + fmtTime(p['正文修改']) }) : null),
      sayBox, chipBox));
    if (p['存在'] === false) { clear(chipBox); continue; }
    api('/api/project' + q({ '路径': p['文件夹'] })).then((d) => {
      if (stale(seq)) return;
      clear(chipBox).appendChild(chips(d['章节'], job));
      draw(d);
    }).catch(() => { if (!stale(seq)) clear(chipBox); });
  }
  grid.appendChild(el('div', { class: 'pcard newcard', role: 'button', tabindex: '0', onclick: () => go('new'), onkeydown: (e) => { if (e.key === 'Enter') go('new'); } },
    icon('plus'), el('div', { text: '写一份新报告' }), el('div', { class: 'note', style: 'font-weight:400', text: '把可研、初设等资料交给程序，它会一章一章写出来' })));
  if (jobsArr.some && jobsArr.some((j) => RUNNING.indexOf(j['状态']) >= 0)) later(() => { if (!stale(seq)) route(); }, 15000);
}
// ---------- 进度条（报告页、任务页共用） ----------
function stageIndex(flow, phase) { return flow.findIndex((g) => g[1].indexOf(phase) >= 0); }
function liveBox(j, opts) {
  opts = opts || {};
  const kind = j['类别'];
  const running = RUNNING.indexOf(j['状态']) >= 0;
  const failed = ['失败', '中断'].indexOf(j['状态']) >= 0;
  const u = j['用量'] || {};
  const box = el('div', { class: 'live' + (failed ? ' fail' : j['状态'] === '完成' ? ' done' : ''), 'aria-live': 'polite' });
  const end = j['结束'] || (running ? Date.now() / 1000 : null);
  const took = j['开始'] && end ? fmtDur(end - j['开始']) : '';
  box.appendChild(el('div', { class: 'top' },
    el('span', { class: 'what', text: kindName(kind) }), statePill(j['状态']),
    el('span', { class: 'note', text: [fmtTime(j['建立']), took ? '用了 ' + took : '', fmtYuan(u['美元']) ? '花了' + fmtYuan(u['美元']).slice(1) + '（估算）' : ''].filter(Boolean).join(' · ') }),
    el('span', { class: 'spacer' }), opts.actions || null));
  const flow = (FLOW[kind] || []).slice();
  if (flow.length > 1) {
    let at = stageIndex(flow, j['阶段']);
    if (at < 0) at = running ? 0 : (j['状态'] === '完成' ? flow.length - 1 : 0);
    box.appendChild(el('div', { class: 'steps' }, flow.map((g, i) => {
      let cls = '';
      if (i < at || (i === at && j['状态'] === '完成')) cls = 'done';
      else if (i === at && running) cls = 'now';
      else if (i === at && failed) cls = 'fail';
      return el('div', { class: 's ' + cls }, el('span', { class: 'b', text: cls === 'done' ? '✓' : cls === 'fail' ? '!' : String(i + 1) }), g[0]);
    })));
  }
  const ss = Array.isArray(j['步骤']) ? j['步骤'] : [];
  // 写章、审章：数一数做完几个
  const unit = j['阶段'] === '写作' ? /^写 \S+\.md/ : j['阶段'] === '逐章审' ? /^审 \S+\.md/ : null;
  if (unit && (running || failed)) {
    const mine = ss.filter((s) => unit.test(s['名称'] || ''));
    const done = mine.filter((s) => s['状态'] === '完成').length;
    const total = opts.total || 0;
    const word = j['阶段'] === '写作' ? '写好' : '审完';
    box.appendChild(el('div', { class: 'now', text: word + ' ' + done + (total ? ' / ' + total : '') + ' 个文件' }));
    if (total) box.appendChild(el('div', { class: 'bar' }, el('i', { style: 'width:' + Math.min(100, Math.round(done * 100 / total)) + '%' })));
  }
  if (running) {
    const doing = ss.filter((s) => s['状态'] === '进行').map((s) => stepName(s['名称']));
    const names = doing.length ? doing : (j['进行中'] || []).map(stepName);
    box.appendChild(el('div', { class: 'now' }, el('b', { text: '正在：' }), names.length ? names.slice(0, 5).join('、') + (names.length > 5 ? ' 等 ' + names.length + ' 件' : '') : '准备中…'));
  }
  if (failed || j['状态'] === '已取消') box.appendChild(el('div', { class: 'say' + (failed ? ' bad' : ''), text: errSay(j) }));
  if (opts.result) box.appendChild(opts.result);
  return box;
}
async function againJob(jid, btn) {
  if (!window.confirm('接着做会接着调用模型、要花钱；上次做完的步骤不重做。现在接着做？')) return;
  if (btn) btn.disabled = true;
  try { const d = await api('/api/jobs/' + enc(jid) + '/again', {}); toast('已经接着做了'); go('job/' + d['号']); }
  catch (e) { if (!DEAD) toast(errText(e), true); }
  finally { if (btn) btn.disabled = false; }
}
async function cancelJob(jid, btn) {
  if (!window.confirm('确定停下？正在进行的这一步做完后停，已经改好的部分会保留。')) return;
  if (btn) btn.disabled = true;
  try { const d = await api('/api/jobs/' + enc(jid) + '/cancel', {}); toast(d['说明'] || '已请求停下', !d['取消']); }
  catch (e) { if (!DEAD) toast(errText(e), true); }
  finally { if (btn) btn.disabled = false; }
}
function jobButtons(j) {
  const out = [];
  if (RUNNING.indexOf(j['状态']) >= 0) { const b = el('button', { class: 'danger small' }, icon('stop'), '停下'); b.addEventListener('click', () => cancelJob(j['号'], b)); out.push(b); }
  if (canAgain(j)) { const b = el('button', { class: 'main' }, icon('play'), '接着做'); b.addEventListener('click', () => againJob(j['号'], b)); out.push(b); }
  return out.length ? el('div', { class: 'acts' }, out) : null;
}
// ---------- 做完以后：结果说成几句话 ----------
function resultLines(j) {
  const r = j['结果'];
  if (!r || typeof r !== 'object') return [];
  const k = j['类别'], out = [];
  const chk = (c) => c ? '自查：必须改的 ' + (c['错误'] || 0) + ' 处、建议看看的 ' + (c['提示'] || 0) + ' 处' : '';
  const pub = (p) => p ? (p['通过'] ? 'PDF 出好了，共 ' + (p['页数'] || '?') + ' 页，目录页码逐页核对过' : 'PDF 没出成，核对没通过') : '';
  if (k === '新报告') {
    if (typeof r['写作'] === 'number') out.push('写好 ' + r['写作'] + ' 个文件');
    else if (r['写作'] && typeof r['写作'] === 'object') out.push('写好 ' + Object.keys(r['写作']).length + ' 个文件');
    if (Array.isArray(r['没写成']) && r['没写成'].length) out.push('没写成：' + r['没写成'].map(chapLabel).join('、'));
    if (r['检查']) out.push(chk(r['检查']));
    if (r['审稿']) out.push('审稿：必改 ' + (r['审稿']['必改'] || 0) + ' 条、建议 ' + (r['审稿']['建议'] || 0) + ' 条，已经改了 ' + (r['审稿']['已改'] || 0) + ' 处');
    if (r['出稿']) out.push(pub(r['出稿']));
  } else if (k === '审稿') {
    if ('审了' in r) out.push('审了 ' + r['审了'] + ' 个文件：必改 ' + (r['必改'] || 0) + ' 条、建议 ' + (r['建议'] || 0) + ' 条，改了 ' + (r['已改'] || 0) + ' 处');
    if (Array.isArray(r['没审成']) && r['没审成'].length) out.push('没审成：' + r['没审成'].map((x) => chapLabel(String(x))).join('、'));
    if (r['出稿']) out.push(pub(r['出稿']));
  } else if (k === '改稿') {
    if (r['口径号'] && /^K\d+/.test(r['口径号'])) out.push('这条意见记成了写作规矩 ' + r['口径号'] + '：' + (r['标题'] || '') + '，以后的报告都照这样写');
    else if (r['标题']) out.push('这条意见只管这份报告：' + r['标题']);
    for (const p of r['项目'] || []) {
      out.push((p['名称'] || '') + '：改了 ' + (p['改'] || 0) + ' 处' + (p['检查'] ? '；' + chk(p['检查']) : '') + (p['出稿'] ? '；' + pub(p['出稿']) : '') + (p['说明'] ? '（' + p['说明'] + '）' : ''));
    }
  } else if (k === '出稿') {
    out.push(pub(r));
  } else if (k === '配图') {
    if ((r['画了'] || []).length) out.push('画了：' + r['画了'].join('、'));
    if ((r['截了'] || []).length) out.push('从资料里截了：' + r['截了'].join('、'));
    if ((r['没找到'] || []).length) out.push('没找到：' + r['没找到'].join('、') + '（已列进资料欠缺清单）');
    if (r['检查']) out.push(chk(r['检查']));
  } else if (k === '事实库') {
    out.push('项目情况整理好了：' + (r['事实'] || 0) + ' 条，补充 ' + (r['补充'] || 0) + ' 条、更正 ' + (r['更正'] || 0) + ' 条');
  }
  return out.filter(Boolean);
}
function resultBox(j, onProject) {
  const lines = resultLines(j);
  const r = j['结果'];
  if (!lines.length && (r === null || r === undefined)) return null;
  const box = el('div', { style: 'margin-top:12px' });
  if (lines.length) box.appendChild(el('ul', { style: 'margin:0;padding-left:22px' }, lines.map((x) => el('li', { text: x }))));
  const acts = el('div', { class: 'acts', style: 'margin-top:10px' });
  if (j['项目'] && onProject !== true) acts.appendChild(el('button', { onclick: () => go(projHash(j['项目'], 'doc')) }, icon('file'), '看这份报告'));
  if (j['项目'] && ['审稿', '改稿', '新报告'].indexOf(j['类别']) >= 0) acts.appendChild(el('button', { onclick: () => go(projHash(j['项目'], 'changes')) }, icon('edit'), '看改过的地方'));
  if (r && r['交稿说明']) acts.appendChild(el('button', { onclick: () => openPath(r['交稿说明']) }, icon('note'), '交稿说明'));
  if (acts.childNodes.length) box.appendChild(acts);
  return box;
}
// ---------- 正文显示：简单排版，每行带行号，有问题的行标色 ----------
function inline(text) {
  // **粗体** 和 <br>；别的照原样当文字
  const frag = document.createDocumentFragment();
  String(text).split(/(<br\s*\/?>)/i).forEach((part, i) => {
    if (i % 2) { frag.appendChild(el('br')); return; }
    part.split('**').forEach((s, k) => { if (s) frag.appendChild(k % 2 ? el('b', { text: s }) : document.createTextNode(s)); });
  });
  return frag;
}
function cells(ln) { return ln.trim().replace(/^\|/, '').replace(/\|$/, '').split(/(?<!\\)\|/).map((c) => c.trim().replace(/\\\|/g, '|')); }
function renderDoc(text, flags) {
  // flags：{行号: [{bad: 是不是必须改, text}]}
  const lines = String(text).split('\n');
  const box = el('div', { class: 'doc' });
  const mark = (node, from, to) => {
    const hit = [];
    for (let n = from; n <= to; n++) if (flags[n]) hit.push(...flags[n]);
    if (hit.length) {
      node.classList.add(hit.some((h) => h.bad) ? 'flagbad' : 'flag');
      hit.slice(0, 4).forEach((h) => node.appendChild(el('span', { class: 'why' + (h.bad ? '' : ' w'), text: (h.bad ? '必须改：' : '看看：') + h.text })));
    }
    for (let n = from; n <= to; n++) if (n !== from) { const a = el('span', { id: 'L' + n }); node.appendChild(a); }
    return node;
  };
  for (let i = 0; i < lines.length; i++) {
    const ln = lines[i], no = i + 1;
    const wrap = (inner, last) => mark(el('div', { class: 'ln', id: 'L' + no }, el('span', { class: 'num', text: no }), inner), no, last || no);
    if (/^\s*\|/.test(ln)) {               // 表格：连着的几行拼一张表
      let j = i;
      while (j + 1 < lines.length && /^\s*\|/.test(lines[j + 1])) j++;
      const rows = lines.slice(i, j + 1).filter((r) => !/^\s*\|[\s:|-]+\|\s*$/.test(r));
      const t = el('table', null, rows.map((r, k) => el('tr', null, cells(r).map((c) => el(k === 0 ? 'th' : 'td', null, inline(c))))));
      box.appendChild(wrap(el('div', { class: 'tbl' }, t), j + 1));
      i = j; continue;
    }
    if (/^\s*<!--/.test(ln)) {              // 注释（可能跨几行）
      let j = i;
      while (j < lines.length - 1 && !/-->/.test(lines[j])) j++;
      box.appendChild(wrap(el('details', { class: 'cmt' }, el('summary', { style: 'cursor:pointer', text: '编写备注（出 PDF 时不印出来）' }),
        el('div', { text: lines.slice(i, j + 1).join(' ').replace(/<!--|-->/g, '').trim() })), j + 1));
      i = j; continue;
    }
    let m;
    if ((m = /^(#{1,4})\s+(.*)$/.exec(ln))) { box.appendChild(wrap(el('h' + m[1].length, null, inline(m[2])))); continue; }
    if ((m = /^\s*!\[([^\]]*)\]\(([^)]*)\)/.exec(ln))) { box.appendChild(wrap(el('div', { class: 'img', text: '［插图：' + (m[1] || baseName(m[2])) + '］' }))); continue; }
    if (!ln.trim()) { if (flags[no]) box.appendChild(wrap(el('div', null, '（空行）'))); continue; }
    const cap = /^\s*(\*\*)?[表图]\s*\d+(\.\d+)*-\d+/.test(ln);
    box.appendChild(wrap(el('div', { class: cap ? 'cap' : '' }, inline(ln))));
  }
  return box;
}
function flagsOf(c) {
  const f = {};
  const add = (arr, bad) => (arr || []).forEach((s) => { const x = splitLine(s); (f[x.line] = f[x.line] || []).push({ bad, text: x.text }); });
  add(c['错误'], true); add(c['提示'], false);
  return f;
}
// ---------- 报告页 ----------
let PREFILL = '';     // “交给程序改”带过去的意见
async function startJob(kind, params, project) {
  const body = { '类别': kind, '参数': params };
  if (project) body['项目'] = project;
  const d = await api('/api/jobs', body);
  toast('已经开始了');
  return d;
}
async function publishNow(d, btn) {
  if (d['错误'] > 0) {
    toast('还有 ' + d['错误'] + ' 处必须改的问题，改完才能出 PDF。已经切到问题清单。', true);
    go(projHash(d['文件夹'], 'issues'));
    return;
  }
  if (!window.confirm('现在出 PDF？生成 Word、转 PDF、逐页核对，大概要几分钟，不花模型的钱。')) return;
  btn.disabled = true;
  try { const j = await startJob('出稿', {}, d['文件夹']); go('job/' + j['号']); }
  catch (e) { if (!DEAD) toast(errText(e), true); }
  finally { btn.disabled = false; }
}
async function showProject(box, seq, path, tab, file, line) {
  if (!path) return go('home');
  box.appendChild(el('div', { class: 'crumb' }, el('button', { class: 'ghost', onclick: () => go('home') }, icon('back'), '全部报告')));
  const body = box.appendChild(el('div', null, el('p', { class: 'muted', text: '正在读取这份报告…' })));
  let d;
  try { d = await api('/api/project' + q({ '路径': path })); }
  catch (e) { if (!stale(seq)) clear(body).appendChild(el('p', { class: 'bad', text: errText(e) })); return; }
  if (stale(seq)) return;
  clear(body);
  const jobsHere = d['做过的事'] || [];
  const job = jobsHere.find((j) => RUNNING.indexOf(j['状态']) >= 0);
  const busy = !!job;
  // 头
  const pubBtn = el('button', { disabled: busy }, icon('pdf'), '出 PDF');
  pubBtn.addEventListener('click', () => publishNow(d, pubBtn));
  const figBtn = el('button', { disabled: busy, title: '画风频玫瑰图，从资料里截区域位置图和平面布置图；第2.5节没有工艺流程图的，请模型排一张。都放进第2章' }, icon('image'), '配图');
  figBtn.addEventListener('click', async () => {
    if (!window.confirm('现在配图？\n\n程序会画风频玫瑰图，从资料里截区域位置图和平面布置图，放进第2章，改之前先备份。\n\n第2.5节没有工艺流程图时，会调一次模型排框（排得不合格会再改一次），一共 1 美元（约 7 元）以内。已经有工艺流程图的不调模型，不花钱。')) return;
    figBtn.disabled = true;
    try { const j = await startJob('配图', {}, d['文件夹']); go('job/' + j['号']); }
    catch (e) { if (!DEAD) toast(errText(e), true); }
    finally { figBtn.disabled = false; }
  });
  const code = codeOf(d['项目']);
  body.appendChild(el('div', { class: 'phead' },
    el('div', { class: 'ttl' }, el('h2', { text: shortName(d['项目']) }),
      el('div', { class: 'meta row note' }, code ? el('span', { text: '编号 ' + code }) : null, el('span', { text: d['方法'] }),
        d['定稿'] ? pill('ok', '定稿') : null, d['PDF'] ? el('span', { text: '最新 PDF：' + fmtTime(d['PDF']['时间']) + (d['PDF']['页数'] ? '，' + d['PDF']['页数'] + ' 页' : '') }) : el('span', { text: '还没出过 PDF' }))),
    el('div', { class: 'acts' },
      el('button', { class: 'main', disabled: busy, onclick: () => go('revise/' + enc(d['文件夹'])) }, icon('edit'), '照意见修改'),
      el('button', { disabled: busy, onclick: () => go('review/' + enc(d['文件夹'])) }, icon('search'), '全文审一遍'),
      pubBtn,
      figBtn,
      d['PDF'] ? el('button', { onclick: () => openPath(d['PDF']['路径']) }, icon('pdf'), '看 PDF') : null,
      el('button', { onclick: () => openPath(d['文件夹']) }, icon('folder'), '打开文件夹'),
      d['交稿说明'] ? el('button', { onclick: () => openPath(d['交稿说明']) }, icon('note'), '交稿说明') : null)));
  if (busy) body.appendChild(el('p', { class: 'note', text: '程序正在做这份报告，做完以前不能再开始别的事。' }));
  // 正在做 / 上次出错
  const liveWrap = body.appendChild(el('div'));
  const last = jobsHere[0];
  const recent = last && last['结束'] && Date.now() / 1000 - last['结束'] < 3600;
  const showJobLive = async () => {
    const pick1 = job || (last && (canAgain(last) || recent) ? last : null);
    if (!pick1) return;
    let j = pick1;
    try { j = await api('/api/jobs/' + enc(pick1['号'])); } catch (e) { /* 用列表里的简要记录 */ }
    markLater(j, jobsHere);
    if (stale(seq)) return;
    const total = j['阶段'] === '写作' || j['阶段'] === '逐章审' ? d['章节'].length : 0;
    clear(liveWrap).appendChild(liveBox(j, { total, actions: el('div', { class: 'acts' }, jobButtons(j),
      el('button', { class: 'small', onclick: () => go('job/' + j['号']) }, '细节')), result: resultBox(j, true) }));
    if (RUNNING.indexOf(j['状态']) >= 0) later(async () => {
      if (stale(seq)) return;
      let now; try { now = await api('/api/jobs/' + enc(j['号'])); } catch (e) { now = null; }
      if (stale(seq)) return;
      if (now && RUNNING.indexOf(now['状态']) < 0) route(); else showJobLive();
    }, 4000);
  };
  showJobLive();
  // 数字
  const errN = d['错误'] || 0, hintN = d['提示'] || 0, todoN = d['待办'] || 0;
  const written = d['章节'].filter((c) => c['写好']).length;
  body.appendChild(el('div', { class: 'stats' },
    el('div', { class: 'stat ' + (written === d['章节'].length ? 'ok' : 'warn') }, el('div', { class: 'n', text: written + ' / ' + d['章节'].length }), el('div', { class: 'l', text: '个文件写好了' })),
    el('div', { class: 'stat ' + (errN ? 'bad' : 'ok') }, el('div', { class: 'n', text: errN }), el('div', { class: 'l', text: errN ? '处必须改（改完才能出 PDF）' : '处必须改，可以出 PDF' })),
    el('div', { class: 'stat warn' }, el('div', { class: 'n', text: hintN }), el('div', { class: 'l', text: '处建议看看（人工确认）' })),
    el('div', { class: 'stat' }, el('div', { class: 'n', text: todoN }), el('div', { class: 'l', text: '处待填的空（等资料）' }))));
  // 左边目录、右边内容
  const toc = el('div', { class: 'card toc' }, el('div', { class: 'h', text: '各章' }));
  const pane = el('div', { class: 'card', style: 'min-width:0' });
  body.appendChild(el('div', { class: 'layout' }, toc, pane));
  if (!file || !d['章节'].some((c) => c['文件'] === file)) file = (d['章节'][0] || {})['文件'] || '';
  for (const c of d['章节']) {
    const e = (c['错误'] || []).length, h = (c['提示'] || []).length;
    const sub = !c['写好'] ? '还没写' : [fmtNum(c['字数']) + ' 字', e ? '必须改 ' + e : '', h ? '看看 ' + h : '', c['审过'] ? '审过' : ''].filter(Boolean).join(' · ');
    toc.appendChild(el('button', { class: tab === 'doc' && c['文件'] === file ? 'on' : '', onclick: () => go(projHash(d['文件夹'], 'doc', c['文件'])) },
      el('span', { class: 'no ' + (e ? 'err' : c['写好'] ? 'done' : ''), text: chapNo(c['文件']) }),
      el('span', { class: 'nm' }, chapName(c['文件'], c['标题']), el('span', { class: 'sub' + (e ? ' bad' : ''), text: sub }))));
  }
  const allIssues = d['章节'].concat(d['其他文件'] || []);
  const tabs = [['doc', '正文', null], ['issues', '问题清单', errN || hintN ? (errN ? errN + ' 必改' : hintN) : 0, errN > 0],
    ['gaps', '资料欠缺', d['资料欠缺'] ? (d['资料欠缺']['要补'] || []).length || null : null, (d['资料欠缺'] && (d['资料欠缺']['要补'] || []).length > 0)],
    ['changes', '改过的地方', null], ['jobs', '做过的事', jobsHere.length || null]];
  pane.appendChild(el('div', { class: 'tabs', role: 'tablist' }, tabs.map((t) => el('button', { role: 'tab', 'aria-selected': t[0] === tab ? 'true' : 'false', class: t[0] === tab ? 'on' : '',
    onclick: () => go(projHash(d['文件夹'], t[0], t[0] === 'doc' ? file : '')) }, t[1], t[2] ? el('span', { class: 'cnt' + (t[3] ? ' bad' : ''), text: t[2] }) : null))));
  const inner = pane.appendChild(el('div'));
  if (tab === 'issues') return issuesTab(inner, d, allIssues);
  if (tab === 'gaps') return gapsTab(inner, d);
  if (tab === 'changes') return changesTab(inner, seq, d);
