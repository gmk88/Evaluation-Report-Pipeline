async function docTab(box, seq, d, file, line) {
  const c = d['章节'].find((x) => x['文件'] === file);
  if (!c) { box.appendChild(empty('这份报告还没有正文。')); return; }
  const e = c['错误'] || [], h = c['提示'] || [];
  box.appendChild(el('div', { class: 'row', style: 'margin-bottom:10px' },
    el('b', { text: chapLabel(file) + ' ' + chapName(file, c['标题']) }),
    e.length ? pill('bad', '必须改 ' + e.length + ' 处') : pill('ok', '没有必须改的'),
    h.length ? pill('warn', '建议看看 ' + h.length + ' 处') : null,
    el('span', { class: 'spacer' }),
    el('span', { class: 'note', text: '改于 ' + fmtTime(c['修改']) }),
    el('button', { class: 'small', onclick: () => openPath(joinPath(d['文件夹'], '正文', file)) }, '在电脑上打开')));
  if (e.length || h.length) box.appendChild(el('p', { class: 'note', style: 'margin-top:0', text: '红底的行是必须改的，黄底的行建议看一眼。要改就点上面的“照意见修改”，把要怎么改写进去。' }));
  const holder = box.appendChild(el('div', null, el('p', { class: 'muted', text: '正在读取正文…' })));
  let t;
  try { t = await api('/api/file' + q({ '路径': joinPath(d['文件夹'], '正文', file) })); }
  catch (err) { if (!stale(seq)) clear(holder).appendChild(el('p', { class: 'bad', text: errText(err) })); return; }
  if (stale(seq)) return;
  clear(holder).appendChild(renderDoc(t['文字'] || '', flagsOf(c)));
  if (line) {
    const target = $('L' + line);
    if (target) {
      const ln = target.closest('.ln') || target;
      ln.classList.add('hit');
      setTimeout(() => ln.scrollIntoView({ block: 'center' }), 50);
    }
  }
}
function joinPath(dir, ...names) {
  const sep = dir.indexOf('\\') >= 0 && dir.indexOf('/') < 0 ? '\\' : '/';
  return dir.replace(/[\\\/]+$/, '') + sep + names.join(sep);
}
let issueKind = 'bad';
function issuesTab(box, d, files) {
  const kinds = [['bad', '必须改', '错误'], ['warn', '建议看看', '提示'], ['todo', '待填的空', '待办']];
  const counts = kinds.map((k) => files.reduce((n, f) => n + (f[k[2]] || []).length, 0));
  if (counts[0] === 0 && issueKind === 'bad') issueKind = counts[1] ? 'warn' : 'todo';
  const bar = box.appendChild(el('div', { class: 'filter' }));
  const list = box.appendChild(el('div'));
  const draw = () => {
    clear(bar);
    kinds.forEach((k, i) => bar.appendChild(el('button', { class: 'small' + (issueKind === k[0] ? ' on' : ''), onclick: () => { issueKind = k[0]; draw(); } }, k[1] + ' ' + counts[i])));
    clear(list);
    const k = kinds.find((x) => x[0] === issueKind);
    if (issueKind === 'bad') list.appendChild(el('p', { class: 'note', style: 'margin-top:0', text: '机器检查查出来的，出 PDF 前要全部改掉。点一条跳到正文那一行。' }));
    if (issueKind === 'warn') list.appendChild(el('p', { class: 'note', style: 'margin-top:0', text: '机器拿不准的，请人看一眼：多数是正常写法，不用改。' }));
    if (issueKind === 'todo') list.appendChild(el('p', { class: 'note', style: 'margin-top:0', text: '正文里还留着的空格，一般要等建设单位给资料再填。' }));
    let any = false;
    for (const f of files) {
      const arr = f[k[2]] || [];
      if (!arr.length) continue;
      any = true;
      const isBody = /\.md$/.test(f['文件']) && d['章节'].some((c) => c['文件'] === f['文件']);
      const g = list.appendChild(el('div', { class: 'group' }, el('div', { class: 'gh' },
        isBody ? chapLabel(f['文件']) + ' ' + chapName(f['文件'], f['标题']) : ({ '正文': '全文', '检查规则.md': '这份报告自己的检查规则', '项目信息.md': '项目信息（编号、名称、日期等）' }[f['文件']] || f['文件']), pill(k[0] === 'todo' ? '' : k[0], arr.length + ' 处'))));
      const shown = arr.slice(0, 80);
      for (const s of shown) {
        const x = splitLine(s);
        const jump = isBody && x.line ? () => go(projHash(d['文件夹'], 'doc', f['文件'], x.line)) : null;
        const fix = issueKind !== 'todo' && isBody ? el('button', { class: 'small', onclick: (ev) => {
          ev.stopPropagation();
          PREFILL = chapLabel(f['文件']) + (x.line ? '第' + x.line + '行' : '') + '：' + x.text + '\n（请改掉这一处）';
          go('revise/' + enc(d['文件夹']));
        } }, '交给程序改') : null;
        g.appendChild(el('div', { class: 'issue ' + k[0], role: jump ? 'link' : null, tabindex: jump ? '0' : null, style: jump ? 'cursor:pointer' : '',
          onclick: jump, onkeydown: jump ? (ev) => { if (ev.key === 'Enter') jump(); } : null },
          el('span', { class: 'where', text: x.line ? '第 ' + x.line + ' 行' : '' }), el('span', { class: 'what', text: x.text }), fix));
      }
      if (arr.length > shown.length) g.appendChild(el('p', { class: 'note', text: '……还有 ' + (arr.length - shown.length) + ' 处没列出' }));
    }
    if (!any) list.appendChild(empty(issueKind === 'bad' ? '没有必须改的问题，可以出 PDF。' : '没有。'));
  };
  draw();
}
function diffNode(seg, oldText, newText) {
  if (Array.isArray(seg)) return el('div', { class: 'diff' }, seg.map((s) => s[0] === '-' ? el('del', { text: s[1] }) : s[0] === '+' ? el('ins', { text: s[1] }) : document.createTextNode(s[1])));
  if (!oldText) return el('div', { class: 'diff' }, el('ins', { text: newText || '' }));
  if (!newText) return el('div', { class: 'diff' }, el('del', { text: oldText }));
  return el('div', { class: 'two' }, el('div', { class: 'o' }, el('span', { class: 'lab', text: '原来' }), oldText), el('div', { class: 'n' }, el('span', { class: 'lab', text: '现在' }), newText));
}
// ---------- 资料欠缺清单（不进报告，转给建设单位要资料用） ----------
function gapsTab(box, d) {
  const g = d['资料欠缺'];
  if (!g) { box.appendChild(empty('资料欠缺清单读不出来。')); return; }
  const need = g['要补'] || [], better = g['补了更准'] || [], skip = g['可以不补'] || [];
  box.appendChild(el('div', { class: 'row', style: 'margin-bottom:8px' },
    el('span', { class: 'note', text: '这份清单不进报告，是转给建设单位要资料用的。' + (g['时间'] ? '整理于 ' + g['时间'] + '。' : '') }),
    el('span', { class: 'spacer' }),
    d['资料欠缺文件'] ? el('button', { class: 'small', onclick: () => openPath(d['资料欠缺文件']) }, icon('note'), '打开清单文件（转给建设单位）')
      : el('span', { class: 'note', text: '出 PDF 时会写一份清单文件放进“输出”文件夹' })));
  const table = (rows, cols) => el('div', { class: 'tablewrap' }, el('table', { class: 'list' },
    el('thead', null, el('tr', null, cols.map((c) => el('th', { text: c[1] })))),
    el('tbody', null, rows.map((r) => el('tr', null, cols.map((c, i) => el('td', { style: i === 0 ? 'font-weight:600' : '', text: r[c[0]] || '' })))))));
  const g1 = box.appendChild(el('div', { class: 'group' }, el('div', { class: 'gh' }, '要补', pill(need.length ? 'bad' : 'ok', need.length + ' 项'))));
  g1.appendChild(need.length ? table(need, [['缺什么', '缺什么'], ['用在', '用在哪'], ['找谁', '找谁要'], ['现在', '现在报告里怎么写的']]) : empty('没有非补不可的资料。'));
  const fold = (title, rows, cols, sub) => {
    if (!rows.length) return;
    box.appendChild(el('details', { class: 'more group' }, el('summary', { text: title + '（' + rows.length + ' 项）' + (sub ? '：' + sub : '') }),
      el('div', { style: 'margin-top:8px' }, table(rows, cols))));
  };
  fold('补了更准', better, [['缺什么', '缺什么'], ['现在', '现在报告里怎么写的']], '没有也能出报告，补来写得更具体');
  fold('可以不补', skip, [['缺什么', '缺什么'], ['用在', '用在哪']], '有了更好，没有不影响结论');
}
let changeView = 'diff', reviewOnly = '全部';
async function changesTab(box, seq, d, backup) {
  const head = box.appendChild(el('div', { class: 'filter' }));
  const out = box.appendChild(el('div', null, el('p', { class: 'muted', text: '正在比对…' })));
  let c;
  try { c = await api('/api/project/changes' + q(backup ? { '路径': d['文件夹'], '备份': backup } : { '路径': d['文件夹'] })); }
  catch (e) { if (!stale(seq)) clear(out).appendChild(el('p', { class: 'bad', text: errText(e) })); return; }
  if (stale(seq)) return;
  const opsN = (c['审稿'] || []).reduce((n, r) => n + r['意见'].length, 0);
  const spotsN = (c['改动'] || []).reduce((n, f) => n + f['共'], 0);
  const draw = () => {
    clear(head).append(
      el('button', { class: 'small' + (changeView === 'diff' ? ' on' : ''), onclick: () => { changeView = 'diff'; draw(); } }, '和改之前比 ' + spotsN + ' 处'),
      el('button', { class: 'small' + (changeView === 'review' ? ' on' : ''), onclick: () => { changeView = 'review'; draw(); } }, '审稿意见 ' + opsN + ' 条'));
    clear(out);
    if (changeView === 'review') return drawReviews(out, d, c);
    const backs = c['备份'] || [];
    if (!backs.length) { out.appendChild(empty('还没有改稿或审稿前的备份，没有可比的。程序每次改正文以前都会先存一份，以后就能在这里看到改了哪几句。')); return; }
    const sel = el('select', { style: 'width:auto;max-width:100%', 'aria-label': '和哪一次改之前比' },
      backs.map((b) => el('option', { value: b['名'], selected: b['名'] === c['对比'], text: fmtTime(b['时间']) + ' ' + (b['说明'] || '') })));
    sel.addEventListener('change', () => { clear(box); changesTab(box, seq, d, sel.value); });
    out.appendChild(el('div', { class: 'row', style: 'margin-bottom:12px' }, el('span', { text: '和这一次改之前的正文比：' }), sel));
    out.appendChild(el('p', { class: 'note', style: 'margin-top:0' }, '红色划掉的是删了的字，绿色的是加上的字。', el('del', { style: 'background:var(--del);color:var(--del-text)', text: '删掉' }), ' ', el('ins', { style: 'background:var(--ins);color:var(--ins-text);text-decoration:none', text: '加上' })));
    if (!c['改动'].length) { out.appendChild(empty('从那次以后正文没有变过。')); return; }
    for (const f of c['改动']) {
      const g = out.appendChild(el('div', { class: 'group' }, el('div', { class: 'gh' }, chapLabel(f['文件']) + ' ' + chapName(f['文件'], f['标题']), pill('run', f['共'] + ' 处'))));
      for (const s of f['处']) {
        g.appendChild(el('div', { class: 'change' },
          el('div', { class: 'ch' }, el('span', { text: '现在第 ' + s['行'] + ' 行' }), el('span', { class: 'spacer' }),
            el('button', { class: 'small', onclick: () => go(projHash(d['文件夹'], 'doc', f['文件'], s['行'])) }, '在正文里看')),
          el('div', { class: 'cb' }, diffNode(s['逐字'], s['原文'], s['改成']))));
      }
      if (f['共'] > f['处'].length) g.appendChild(el('p', { class: 'note', text: '……还有 ' + (f['共'] - f['处'].length) + ' 处没列出' }));
    }
  };
  draw();
}
function drawReviews(out, d, c) {
  const all = c['审稿'] || [];
  if (!all.length) { out.appendChild(empty('这份报告还没用程序审过。点上面的“全文审一遍”。')); return; }
  const state = (o) => o['结果'] === '已改' ? '已改' : (!o['结果'] || o['结果'] === '没改') ? '只提意见' : '没改';
  const bar = out.appendChild(el('div', { class: 'filter' }));
  ['全部', '已改', '没改', '只提意见'].forEach((k) => bar.appendChild(el('button', { class: 'small' + (reviewOnly === k ? ' on' : ''),
    onclick: () => { reviewOnly = k; clear(out); drawReviews(out, d, c); } }, k + ' ' + all.reduce((n, r) => n + r['意见'].filter((o) => k === '全部' || state(o) === k).length, 0))));
  out.appendChild(el('p', { class: 'note', style: 'margin-top:0', text: '审稿程序每条意见都写了依据。“没改”的是程序拿不准、留给人定的（比如说资料里查不到，可原文里其实有）。' }));
  for (const r of all) {
    const ops = r['意见'].filter((o) => reviewOnly === '全部' || state(o) === reviewOnly);
    if (!ops.length) continue;
    const g = out.appendChild(el('div', { class: 'group' }, el('div', { class: 'gh' }, chapLabel(r['文件']) + ' ' + chapName(r['文件']), el('span', { class: 'note', style: 'font-weight:400', text: '审于 ' + fmtTime(r['时间']) }))));
    for (const o of ops) {
      const st = state(o);
      g.appendChild(el('div', { class: 'change' },
        el('div', { class: 'ch' }, pill(o['级别'] === '必改' ? 'bad' : 'warn', o['级别'] || '意见'), pill(st === '已改' ? 'ok' : st === '没改' ? 'warn' : '', st),
          el('span', { text: o['行'] ? '第 ' + o['行'] + ' 行' : '' }), el('span', { class: 'spacer' }),
          /^\d+$/.test(o['行'] || '') ? el('button', { class: 'small', onclick: () => go(projHash(d['文件夹'], 'doc', r['文件'], o['行'])) }, '在正文里看') : null),
        el('div', { class: 'cb' }, el('div', { style: 'font-weight:600;margin-bottom:6px', text: o['问题'] }),
          (o['原文'] || o['改成']) ? diffNode(o['逐字'], o['原文'], o['改成']) : null,
          el('div', { class: 'why' }, o['依据'] ? [el('b', { text: '依据：' }), o['依据']] : null,
            st === '没改' && o['结果'] ? el('div', null, el('b', { text: '为什么没改：' }), o['结果']) : null))));
    }
  }
  if (c['跨章']) out.appendChild(el('details', { class: 'more' }, el('summary', { text: '前后各章对一遍的记录' }), el('pre', { class: 'text', text: c['跨章'] })));
}
// ---------- 做过的事 ----------
function jobProject(j) { return shortName(j['项目名']) || baseName(j['项目']) || (j['类别'] === '改稿' ? '（几份报告一起改）' : ''); }
function jobsTable(box, arr, emptyText, withProject) {
  if (!arr.length) { box.appendChild(empty(emptyText)); return; }
  const tb = el('tbody');
  for (const j of arr) {
    const u = j['用量'] || {};
    const end = j['结束'] || (RUNNING.indexOf(j['状态']) >= 0 ? Date.now() / 1000 : null);
    const doing = RUNNING.indexOf(j['状态']) >= 0 && (j['进行中'] || []).length ? '正在：' + j['进行中'].map(stepName).slice(0, 3).join('、') : '';
    const title = j['类别'] === '改稿' ? '意见：' + String(j['标题'] || '').replace(/^改稿：/, '') : j['类别'] === '审稿' && /第/.test(j['标题'] || '') ? String(j['标题']).replace('审稿', '只审') : '';
    tb.appendChild(el('tr', { class: 'click', tabindex: '0', onclick: () => go('job/' + j['号']), onkeydown: (e) => { if (e.key === 'Enter') go('job/' + j['号']); } },
      el('td', { text: fmtTime(j['建立']) }),
      el('td', null, el('div', { text: kindName(j['类别']) + (/接着做/.test(j['标题'] || '') ? '（接着做）' : '') }), title ? el('div', { class: 'note', text: title }) : null, doing ? el('div', { class: 'note', text: doing }) : null),
      withProject ? el('td', { text: jobProject(j) }) : null,
      el('td', null, statePill(j['状态'])),
      el('td', { text: j['开始'] && end ? fmtDur(end - j['开始']) : '' }),
      el('td', { class: 'num', text: fmtYuan(u['美元']) || '—' })));
  }
  box.appendChild(el('div', { class: 'tablewrap' }, el('table', { class: 'list' },
    el('thead', null, el('tr', null, el('th', { text: '时间' }), el('th', { text: '做了什么' }), withProject ? el('th', { text: '报告' }) : null,
      el('th', { text: '结果' }), el('th', { text: '用时' }), el('th', { class: 'num', text: '花费（估算）' }))), tb)));
}
async function showHistory(box, seq) {
  box.append(el('h2', { text: '做过的事' }), el('p', { class: 'lead', text: '程序写稿、审稿、改稿、出 PDF 的每一次记录。点一行看细节。花费按官方价估算，实际以中转账单为准。' }));
  const list = box.appendChild(el('div', { class: 'card' }, el('p', { class: 'muted', text: '正在读取…' })));
  const tick = async () => {
    let arr;
    try { arr = await api('/api/jobs'); }
    catch (e) { if (!stale(seq)) clear(list).appendChild(el('p', { class: 'bad', text: errText(e) })); return; }
    if (stale(seq)) return;
    arr = Array.isArray(arr) ? arr.slice() : [];
    arr.sort((a, b) => (RUNNING.indexOf(b['状态']) >= 0) - (RUNNING.indexOf(a['状态']) >= 0) || (b['建立'] || 0) - (a['建立'] || 0));
    clear(list);
    jobsTable(list, arr, '还没有做过事。回到“报告”页开始。', true);
    if (arr.some((j) => RUNNING.indexOf(j['状态']) >= 0)) later(tick, 3000);
  };
  tick();
}
function showJob(box, seq, jid) {
  box.appendChild(el('div', { class: 'crumb' }, el('button', { class: 'ghost', onclick: () => history.length > 1 ? history.back() : go('history') }, icon('back'), '返回')));
  const top = box.appendChild(el('div'));
  const detail = box.appendChild(el('details', { class: 'more card', style: 'margin-top:4px' }, el('summary', { text: '细节：每一步和原始记录（给懂行的人看）' })));
  const stepsBox = detail.appendChild(el('div', { style: 'margin-top:10px' }));
  const logBox = detail.appendChild(el('pre', { class: 'text', tabindex: '0', 'aria-label': '原始记录' }));
  let logKey = '', failures = 0, head = '';
  const render = (j) => {
    const total = j['阶段'] === '写作' || j['阶段'] === '逐章审' ? (j['步骤'] || []).filter((s) => /^(写|审) \S+\.md/.test(s['名称'] || '')).length || 0 : 0;
    const proj = j['项目'] ? el('div', { class: 'row', style: 'margin-bottom:10px' }, el('h2', { style: 'margin:0', text: jobProject(j) }),
      el('button', { class: 'small', onclick: () => go(projHash(j['项目'])) }, '去这份报告')) : el('h2', { text: kindName(j['类别']) });
    const p = j['参数'] || {};
    const said = j['类别'] === '改稿' && p['意见'] ? el('div', { class: 'card', style: 'margin-bottom:14px' }, el('div', { class: 'note', text: '修改意见（原话）' }), el('div', { style: 'white-space:pre-wrap', text: p['意见'] })) : null;
    clear(top).append(proj, liveBox(j, { total, actions: jobButtons(j), result: resultBox(j) }), said || '');
    const ss = Array.isArray(j['步骤']) ? j['步骤'] : [];
    clear(stepsBox).appendChild(ss.length ? el('div', { class: 'tablewrap' }, el('table', { class: 'list' },
      el('thead', null, el('tr', null, ['', '这一步', '结果', '用时', '说明'].map((t) => el('th', { text: t })), el('th', { class: 'num', text: '花费（估算）' }))),
      el('tbody', null, ss.map((s) => {
        const sec = typeof s['秒'] === 'number' ? s['秒'] : s['开始'] ? ((s['结束'] || Date.now() / 1000) - s['开始']) : null;
        const usd = ((s['输入'] || 0) * 4 + (s['输出'] || 0) * 20) / 1e6;
        return el('tr', null, el('td', { class: 'faint', text: s['号'] }), el('td', { text: stepName(s['名称']) }), el('td', null, statePill(s['状态'])),
          el('td', { text: sec === null ? '' : fmtDur(sec) }), el('td', { class: 'note', text: s['说明'] || '' }), el('td', { class: 'num', text: fmtYuan(usd) }));
      }))))
      : el('p', { class: 'muted', text: '还没有步骤。' }));
    const logs = Array.isArray(j['日志']) ? j['日志'] : [];
    const key = logs.length + '|' + JSON.stringify(logs[logs.length - 1] || '');
    if (key !== logKey) {
      logBox.textContent = logs.length ? logs.map((x) => { const t = new Date(Number(x[0]) * 1000); return (isNaN(t.getTime()) ? '' : pad(t.getHours()) + ':' + pad(t.getMinutes()) + ':' + pad(t.getSeconds()) + '  ') + String(x[1]); }).join('\n') : '（还没有记录）';
      logBox.scrollTop = logBox.scrollHeight;
      logKey = key;
    }
    if (j['错误']) { if (head !== j['错误']) { head = j['错误']; detail.appendChild(el('p', { class: 'note', text: '原话：' + j['错误'] })); } }
    return RUNNING.indexOf(j['状态']) >= 0;
  };
  let listed = null;
  const tick = async () => {
    let j;
    try {
      j = await api('/api/jobs/' + enc(jid)); failures = 0;
      if (listed === null && AGAIN_KINDS.indexOf(j['类别']) >= 0) { try { listed = await api('/api/jobs'); } catch (e) { listed = []; } }
      markLater(j, listed);
    }
    catch (e) {
      if (stale(seq)) return;
      if (e.code === 404 || e.code === 400) { clear(top).appendChild(empty('没有这条记录。')); return; }
      if (++failures >= 2) clear(top).appendChild(el('p', { class: 'bad', text: errText(e) }));
      later(tick, 4000); return;
    }
    if (stale(seq)) return;
    if (render(j)) later(tick, 2000);   // 结束了就不再刷新
  };
  tick();
}
// ---------- 表单公用 ----------
let fieldSeq = 0;
function field(label, input, note) {
  const target = input.matches('input,select,textarea') ? input : (input.querySelector('input,select,textarea') || input);
  target.id = target.id || 'f' + (++fieldSeq);
  return el('div', null, el('label', { class: 'f', for: target.id, text: label }), input, note ? el('div', { class: 'note', text: note }) : null);
}
function textInput(value, placeholder) { const i = el('input', { type: 'text', placeholder: placeholder || '' }); i.value = value || ''; return i; }
function check(label, on) {
  const c = el('input', { type: 'checkbox' }); c.checked = !!on;
  return { box: c, label: el('label', null, c, label) };
}
function radio(name, value, title, sub, on) {
  const r = el('input', { type: 'radio', name, value }); r.checked = !!on;
  return el('label', null, r, el('span', null, el('b', { text: title }), sub ? el('small', { text: sub }) : null));
}
function lines(text) { return text.split(/\r?\n/).map((x) => x.trim()).filter(Boolean); }
function wsteps(names, at) { return el('div', { class: 'wsteps' }, names.map((n, i) => el('span', { class: i === at ? 'on' : i < at ? 'done' : '', text: (i + 1) + ' ' + n }))); }
async function findProject(path) {
  try { return await api('/api/project' + q({ '路径': path })); } catch (e) { if (!DEAD) toast(errText(e), true); return null; }
}

// ---------- 写新报告（三步） ----------
async function formNew(box, seq) {
  if (!SETTINGS) await loadSettings();
  if (stale(seq)) return;
  const S = { files: [], where: SETTINGS ? SETTINGS['项目位置'] || '' : '', name: '', method: '', title: '', short: '', code: '', date: '', rv: true, pub: true };
  let at = 0;
  box.appendChild(el('div', { class: 'crumb' }, el('button', { class: 'ghost', onclick: () => go('home') }, icon('back'), '全部报告')));
  box.append(el('h2', { text: '写一份新报告' }), el('p', { class: 'lead', text: '把资料交给程序，它会读资料、整理项目情况、一章一章写，写完自己审一遍、出 PDF。做的时候随时能看到写到哪、花了多少。' }));
  const wrap = box.appendChild(el('div', { class: 'card wizard' }));
  const draw = () => {
    clear(wrap).appendChild(wsteps(['选资料', '填报告信息', '确认开始'], at));
    const msg = el('div', { class: 'msg', role: 'alert' });
    if (at === 0) {
      const list = el('ul', { class: 'files' });
      const paste = el('textarea', { placeholder: '也可以把文件路径粘贴在这里，一行一个', style: 'min-height:70px' });
      const redraw = () => {
        clear(list);
        S.files.forEach((f, i) => list.appendChild(el('li', null, icon('file'), el('span', { text: baseName(f) }), el('span', { class: 'note', text: f }), el('span', { class: 'spacer' }),
          el('button', { class: 'small', onclick: () => { S.files.splice(i, 1); redraw(); } }, '去掉'))));
        if (!S.files.length) list.appendChild(el('li', { class: 'muted', text: '还没有选资料' }));
      };
      const add = (arr) => { arr.forEach((x) => { if (S.files.indexOf(x) < 0) S.files.push(x); }); redraw(); };
      redraw();
      wrap.append(el('div', { class: 'drop' }, el('div', { style: 'margin-bottom:10px', text: '可研报告、初步设计、委托书、合同、平面布置图……有几份选几份' }),
        el('div', { class: 'acts', style: 'justify-content:center' },
          el('button', { class: 'main', onclick: async () => add(await pick('文件', true, '选择资料文件（可以多选）')) }, icon('plus'), '添加文件'),
          el('button', { onclick: async () => add(await pick('文件夹', false, '选择资料文件夹')) }, icon('folder'), '添加整个文件夹'))),
        list, el('details', { class: 'more' }, el('summary', { text: '粘贴路径' }), paste, el('button', { class: 'small', style: 'margin-top:6px', onclick: () => { add(lines(paste.value).map((x) => x.replace(/^["'“”]+|["'“”]+$/g, ''))); paste.value = ''; } }, '加进去')),
        el('div', { class: 'formbtns' }, el('button', { class: 'main big', onclick: () => {
          if (lines(paste.value).length) add(lines(paste.value).map((x) => x.replace(/^["'“”]+|["'“”]+$/g, '')));
          if (!S.files.length) return showMsg(msg, '请至少添加一份资料（可研报告等）', true);
          at = 1; draw();
        } }, '下一步')), msg);
    } else if (at === 1) {
      const where = textInput(S.where, '例如 /Users/名字/Desktop/评价报告项目');
      const name = textInput(S.name, '例如 某某公司某某项目预评价');
      const whereRow = el('div', { class: 'row' }, where, el('button', { onclick: async () => { const r = await pick('文件夹', false, '选择新报告放在哪个文件夹里'); if (r.length) where.value = r[0]; } }, '选择…'));
      const methods = el('div', { class: 'choice', role: 'radiogroup' },
        radio('method', '类比法', '类比法', '找一个同类已投产的项目做对照', S.method === '类比法'),
        radio('method', '风险评估法', '风险评估法', '按危害程度、接触水平打分评风险', S.method === '风险评估法'));
      const title = textInput(S.title, '空着＝程序从资料里读'), short = textInput(S.short, '空着＝程序自己起'), code = textInput(S.code, '例如 AT-2026-Y019'), date = textInput(S.date, '例如 2026年11月');
      const save = () => { Object.assign(S, { where: where.value.trim().replace(/^["'“”]+|["'“”]+$/g, ''), name: name.value.trim(), title: title.value.trim(), short: short.value.trim(), code: code.value.trim(), date: date.value.trim() }); const m = methods.querySelector('input:checked'); S.method = m ? m.value : ''; };
      wrap.append(
        el('div', { class: 'grid2' }, field('放在哪', whereRow), field('新文件夹叫什么（必填）', name, '程序会在“放在哪”里建这个文件夹，报告的一切都放在里面')),
        field('评价方法（必选）', methods, '委托书、合同或可研里一般写了用哪种；拿不准就问一下负责人'),
        el('div', { class: 'grid2' }, field('项目名称', title), field('简称（显示在列表里）', short), field('报告编号', code), field('报告日期', date)),
        el('div', { class: 'formbtns' }, el('button', { onclick: () => { save(); at = 0; draw(); } }, '上一步'), el('button', { class: 'main big', onclick: () => {
          save();
          if (!S.where) return showMsg(msg, '请填“放在哪”', true);
          if (!S.name) return showMsg(msg, '请填“新文件夹叫什么”', true);
          if (/[\\\/:*?"<>|]/.test(S.name)) return showMsg(msg, '文件夹名里不能有 \\ / : * ? " < > | 这些符号', true);
          if (/^\.+$/.test(S.name) || /[. ]$/.test(S.name)) return showMsg(msg, '文件夹名不能只有点，也不能以点或空格结尾', true);
          if (!S.method) return showMsg(msg, '请选择评价方法：类比法或风险评估法', true);
          at = 2; draw();
        } }, '下一步')), msg);
      name.focus();
    } else {
      const rv = check('写完自己审一遍（推荐，多花一些）', S.rv), pub = check('审完出 PDF', S.pub);
      rv.box.addEventListener('change', () => { S.rv = rv.box.checked; }); pub.box.addEventListener('change', () => { S.pub = pub.box.checked; });
      const go1 = el('button', { class: 'main big' }, icon('play'), '开始写');
      go1.addEventListener('click', async () => {
        go1.disabled = true; showMsg(msg, '正在提交…', false);
        try {
          const d = await startJob('新报告', { '文件夹': joinPath(S.where, S.name), '方法': S.method, '资料': S.files, '名称': S.title, '简称': S.short, '编号': S.code, '日期': S.date, '审稿': S.rv, '出稿': S.pub });
          go('job/' + d['号']);
        } catch (e) { if (!DEAD) showMsg(msg, errText(e), true); }
        finally { go1.disabled = false; }
      });
      wrap.append(el('div', { class: 'kv' },
        el('div', { class: 'k', text: '资料' }), el('div', { class: 'v', text: S.files.length + ' 份：' + S.files.map(baseName).join('、') }),
        el('div', { class: 'k', text: '放在' }), el('div', { class: 'v', text: joinPath(S.where, S.name) }),
        el('div', { class: 'k', text: '方法' }), el('div', { text: S.method }),
        el('div', { class: 'k', text: '名称' }), el('div', { text: S.title || '（从资料里读）' }),
        el('div', { class: 'k', text: '编号、日期' }), el('div', { text: [S.code, S.date].filter(Boolean).join('，') || '（没填）' })),
        el('div', { class: 'checks', style: 'margin-top:16px' }, rv.label, pub.label),
        el('div', { class: 'callout', text: '开始以后会调用模型、要花钱。中途断了不要紧：做完的部分会留着，点“接着做”从断的地方继续。' }),
        el('div', { class: 'formbtns' }, el('button', { onclick: () => { at = 1; draw(); } }, '上一步'), go1), msg);
    }
  };
  draw();
}
// ---------- 照意见修改 ----------
async function formRevise(box, seq, path) {
  const d = path ? await findProject(path) : null;
  if (stale(seq)) return;
  const prefill = PREFILL; PREFILL = '';
  box.appendChild(el('div', { class: 'crumb' }, el('button', { class: 'ghost', onclick: () => go(d ? projHash(d['文件夹']) : 'home') }, icon('back'), d ? '回到这份报告' : '全部报告')));
  box.append(el('h2', { text: '照意见修改' }), el('p', { class: 'lead', text: '把专家意见、领导意见照原话贴进来，不用整理。程序会找出该改的地方改好，改之前先备份，改完能在“改过的地方”逐句看。' }));
  const wrap = box.appendChild(el('div', { class: 'card wizard' }));
  const words = el('textarea', { placeholder: '例如：第7章缺氧作业只写正压式空气呼吸器，不要写长管呼吸器', style: 'min-height:200px' });
  words.value = prefill;
  if (!PROJECTS.length) { try { await loadProjects(); } catch (e) { /* 下面会说没有项目 */ } }
  if (stale(seq)) return;
  const all = PROJECTS.filter((p) => p['存在'] !== false && p['文件夹']);
  const scope = el('div', { class: 'choice', role: 'radiogroup' },
    d ? radio('scope', 'one', '只改这一份', shortName(d['项目']), true) : null,
    radio('scope', 'all', '所有报告都改', '共 ' + all.length + ' 份：' + all.map((p) => shortName(p['项目'])).join('、'), !d),
    radio('scope', 'some', '自己挑几份', '', false));
  const somebox = el('div', { class: 'chgrid', style: 'display:none;margin-top:10px' });
  const picks = all.map((p) => { const c = check(shortName(p['项目']), d && p['文件夹'] === d['文件夹']); somebox.appendChild(c.label); return { p, c }; });
  scope.addEventListener('change', () => { somebox.style.display = scope.querySelector('input:checked').value === 'some' ? '' : 'none'; });
  const pub = check('改完出 PDF', true);
  const msg = el('div', { class: 'msg', role: 'alert' });
  const btn = el('button', { class: 'main big' }, icon('play'), '开始修改');
  btn.addEventListener('click', async () => {
    const w = words.value.trim();
    if (!w) return showMsg(msg, '请把修改意见贴进来', true);
    const s = scope.querySelector('input:checked').value;
    let which = '全部';
    if (s === 'one') which = [d['文件夹']];
    if (s === 'some') { which = picks.filter((x) => x.c.box.checked).map((x) => x.p['文件夹']); if (!which.length) return showMsg(msg, '请至少勾一份报告', true); }
    btn.disabled = true; showMsg(msg, '正在提交…', false);
    try { const j = await startJob('改稿', { '意见': w, '项目': which, '出稿': pub.box.checked }); go('job/' + j['号']); }
    catch (e) { if (!DEAD) showMsg(msg, errText(e), true); }
    finally { btn.disabled = false; }
  });
  wrap.append(field('修改意见（照原话）', words),
    el('label', { class: 'f', text: '改哪几份' }), scope, somebox,
    el('div', { class: 'checks', style: 'margin-top:14px' }, pub.label),
    el('div', { class: 'callout', text: '程序会判断这条意见是不是以后都要照办的写法。是的话记进“写作规矩”，以后新写的报告也照这样写，同一条意见不用说第二遍。' }),
    el('div', { class: 'formbtns' }, btn), msg);
  words.focus();
}
// ---------- 全文审一遍 ----------
async function formReview(box, seq, path) {
  const d = path ? await findProject(path) : null;
  if (stale(seq)) return;
  if (!d) { go('home'); return; }
  box.appendChild(el('div', { class: 'crumb' }, el('button', { class: 'ghost', onclick: () => go(projHash(d['文件夹'])) }, icon('back'), '回到这份报告')));
  box.append(el('h2', { text: '审一遍：' + shortName(d['项目']) }), el('p', { class: 'lead', text: '程序按审稿清单、各章要点和写作规矩逐章审，每条意见都写依据。可以只审几章。' }));
  const wrap = box.appendChild(el('div', { class: 'card wizard' }));
  const groups = byChapter(d['章节']);
  const allBox = check('全部章节', true);
  const chs = groups.map((g) => ({ k: g.k, c: check(chapLabel(g.k) + ' ' + chapName(g.files[0]['文件'], g.files.length > 1 ? '' : g.files[0]['标题']), true) }));
  allBox.box.addEventListener('change', () => chs.forEach((x) => { x.c.box.checked = allBox.box.checked; }));
  chs.forEach((x) => x.c.box.addEventListener('change', () => { allBox.box.checked = chs.every((y) => y.c.box.checked); }));
  const focus = textInput('', '例如：重点看第7章防护用品；空着＝全面看');
  const mode = el('div', { class: 'choice', role: 'radiogroup' },
    radio('mode', 'fix', '审出来就改', '改之前自动备份；拿不准的不改，留给你定', true),
    radio('mode', 'look', '只列问题，先别动正文', '看完意见再决定改不改', false));
  const pub = check('审完出 PDF', false);
  mode.addEventListener('change', () => { const look = mode.querySelector('input:checked').value === 'look'; pub.box.disabled = look; if (look) pub.box.checked = false; });
  const msg = el('div', { class: 'msg', role: 'alert' });
  const btn = el('button', { class: 'main big' }, icon('play'), '开始审');
  btn.addEventListener('click', async () => {
    const chosen = chs.filter((x) => x.c.box.checked).map((x) => x.k);
    if (!chosen.length) return showMsg(msg, '请至少勾一章', true);
    const look = mode.querySelector('input:checked').value === 'look';
    btn.disabled = true; showMsg(msg, '正在提交…', false);
    try {
      const j = await startJob('审稿', { '章': allBox.box.checked ? '' : chosen.join(','), '重点': focus.value.trim(), '只看': look, '出稿': pub.box.checked }, d['文件夹']);
      go('job/' + j['号']);
    } catch (e) { if (!DEAD) showMsg(msg, errText(e), true); }
    finally { btn.disabled = false; }
  });
  wrap.append(el('label', { class: 'f', text: '审哪几章' }), el('div', { class: 'checks' }, allBox.label), el('div', { class: 'chgrid' }, chs.map((x) => x.c.label)),
    field('这次特别看什么', focus), el('label', { class: 'f', text: '审出问题以后' }), mode,
    el('div', { class: 'checks', style: 'margin-top:14px' }, pub.label),
    el('div', { class: 'formbtns' }, btn), msg);
}
// ---------- 设置：连接、花费、写作规矩 ----------
let usageDays = 7;
async function showSettings(box, seq) {
  box.append(el('h2', { text: '设置' }), el('p', { class: 'lead', text: '一般不用动。新同事第一次用，在“连接模型”里填上中转地址和密钥就行。' }));
  const s = await loadSettings();
  if (stale(seq)) return;
  if (!s) { box.appendChild(el('p', { class: 'bad', text: '设置读不出来，请刷新页面再试' })); return; }
  const url = textInput(s['地址'] || '', '空着＝用本机 Claude Code 里的地址');
  const key = el('input', { type: 'password', autocomplete: 'new-password', placeholder: s['有密钥'] ? '已经有密钥了；空着＝不改' : '粘贴中转给的密钥' });
  const model = textInput(s['模型'] || '', '例如 claude-opus-5-5');
  const conc = el('input', { type: 'number', min: '1', max: '8', step: '1' }); conc.value = String(s['并发'] || 4);
  const proxy = check('走这台电脑的系统代理（代理软件）', s['走系统代理']);
  const think = check('模型思考时照常发回摘要', s['思考摘要'] !== false);
  const place = textInput(s['项目位置'] || '', '新报告默认放在这里');
  const placeRow = el('div', { class: 'row' }, place, el('button', { onclick: async () => { const r = await pick('文件夹', false, '选择新报告默认放在哪个文件夹'); if (r.length) place.value = r[0]; } }, '选择…'));
  const src = el('div', { class: 'kv' });
  const showSrc = (x) => clear(src).append(
    el('div', { class: 'k', text: '密钥' }), el('div', { class: x['有密钥'] ? 'ok' : 'bad', text: x['有密钥'] ? '有（来自' + (x['密钥来源'] || '') + '）' : '没有设置' }),
    el('div', { class: 'k', text: '实际用的地址' }), el('div', { class: 'v', text: x['地址生效'] || '官方接口' }),
    el('div', { class: 'k', text: '这台电脑' }), el('div', { text: x['系统'] || '' }));
  showSrc(s);
  const msg = el('div', { class: 'msg', role: 'alert' });
  const save = el('button', { class: 'main' }, '保存');
  const test = el('button', null, '测试连接');
  save.addEventListener('click', async () => {
    const n = Number(conc.value);
    if (!Number.isInteger(n) || n < 1 || n > 8) return showMsg(msg, '同时调用的个数要是 1～8 的整数', true);
    if (!model.value.trim()) return showMsg(msg, '请填模型名称（例如 claude-opus-5-5）', true);
    const body = { '地址': url.value.trim(), '模型': model.value.trim(), '并发': n, '走系统代理': proxy.box.checked, '思考摘要': think.box.checked };
    if (place.value.trim()) body['项目位置'] = place.value.trim();   // 空着不改，免得新报告没有默认位置
    if (key.value.trim()) body['密钥'] = key.value.trim();
    save.disabled = true;
    try {
      const d = await api('/api/settings', body);
      key.value = '';
      key.placeholder = d['有密钥'] ? '已经有密钥了；空着＝不改' : '粘贴中转给的密钥';
      showSrc(d);
      await loadSettings();
      showMsg(msg, '已保存', false);
    } catch (e) { if (!DEAD) showMsg(msg, errText(e), true); }
    finally { save.disabled = false; }
  });
  test.addEventListener('click', async () => {
    if (!window.confirm('测试连接会调用一次模型，花费很少。先保存过的设置才会生效。现在测试？')) return;
    test.disabled = true;
    showMsg(msg, '正在测试，最多等一分钟…', false);
    try { const d = await api('/api/settings/test', {}); showMsg(msg, (d['通'] ? '连接正常：' : '连不上：') + (d['说明'] || ''), !d['通']); }
    catch (e) { if (!DEAD) showMsg(msg, errText(e), true); }
    finally { test.disabled = false; }
  });
  box.appendChild(el('div', { class: 'card', style: 'margin-bottom:16px' }, el('h3', { style: 'margin-top:0', text: '连接模型' }),
    el('div', { class: 'grid2' }, field('中转地址', url), field('密钥', key, '密钥只存在这台电脑上，不会拷进流水线文件夹')),
    field('新报告默认放在', placeRow),
    el('details', { class: 'more' }, el('summary', { text: '更多（一般不用改）' }),
      el('div', { class: 'grid2' }, field('模型', model), field('同时调用几个（1～8）', conc)),
      el('div', { style: 'margin-top:12px' }, proxy.label, el('div', { class: 'note', text: '一般不勾：程序直接连中转，代理软件断了也不受影响。这台电脑要靠代理才能连上中转的，才勾上。' })),
      el('div', { style: 'margin-top:8px' }, think.label, el('div', { class: 'note', text: '一般勾着：模型想得久时连接上一直有字在走，中转不会当成断线掐掉；不多花钱。测试连接报“中转返回 400”的，取消勾选、保存后再测。' })),
      el('h3', { text: '现在的连接' }), src),
    el('div', { class: 'formbtns' }, save, test), msg));
  const money = box.appendChild(el('div', { class: 'card', style: 'margin-bottom:16px' }));
  const rules = box.appendChild(el('div', { class: 'card' }));
  drawUsage(money, seq);
  drawRules(rules, seq);
}
async function drawUsage(box, seq) {
  clear(box).append(el('h3', { style: 'margin-top:0', text: '花了多少' }),
    el('div', { class: 'filter' }, el('span', { text: '看最近：' }), [1, 7, 30].map((n) => el('button', { class: 'small' + (n === usageDays ? ' on' : ''), onclick: () => { usageDays = n; drawUsage(box, seq); } }, n === 1 ? '今天' : n + ' 天'))));
  const out = box.appendChild(el('div', null, el('p', { class: 'muted', text: '正在统计…' })));
  let d;
  try { d = await api('/api/usage' + q({ '天': String(usageDays) })); }
  catch (e) { if (!stale(seq)) clear(out).appendChild(el('p', { class: 'bad', text: errText(e) })); return; }
  if (stale(seq)) return;
  clear(out);
  const t = d['合计'] || {};
  if (!t['次数']) { out.appendChild(empty('这段时间没有调用过模型。')); return; }
  out.appendChild(el('p', { style: 'margin-top:0' }, el('b', { style: 'font-size:22px', text: fmtYuan(t['估算美元']) || '¥0' }),
    el('span', { class: 'note', text: '（约 $' + Number(t['估算美元'] || 0).toFixed(2) + '，按官方价估算，实际以中转账单为准）' })));
  const rows = (d['按项目'] || []).slice().sort((a, b) => (b['估算美元'] || 0) - (a['估算美元'] || 0));
  const max = Math.max(...rows.map((r) => r['估算美元'] || 0), 0.0001);
  out.appendChild(el('div', null, rows.map((r) => el('div', { style: 'margin:8px 0' },
    el('div', { class: 'row' }, el('span', { text: shortName(r['项目']) || '（不属于哪份报告）' }), el('span', { class: 'spacer' }), el('b', { text: fmtYuan(r['估算美元']) || '—' })),
    el('div', { class: 'bar' }, el('i', { style: 'width:' + Math.max(2, Math.round((r['估算美元'] || 0) * 100 / max)) + '%' }))))));
  out.appendChild(el('details', { class: 'more' }, el('summary', { text: '按天、按做的事、调用次数和 token（给懂行的人看）' }),
    ['按天', '按任务'].map((k) => el('div', { class: 'tablewrap', style: 'margin-top:10px' }, el('table', { class: 'list' },
      el('thead', null, el('tr', null, el('th', { text: k === '按天' ? '日期' : '做的事' }), ['调用次数', '输入 token', '输出 token', '估算美元'].map((x) => el('th', { class: 'num', text: x })))),
      el('tbody', null, (d[k] || []).map((r) => el('tr', null, el('td', { text: k === '按天' ? r['日期'] : kindName(r['任务']) }),
        el('td', { class: 'num', text: fmtNum(r['次数'] || 0) }), el('td', { class: 'num', text: fmtNum(r['输入'] || 0) }), el('td', { class: 'num', text: fmtNum(r['输出'] || 0) }),
        el('td', { class: 'num', text: '$' + Number(r['估算美元'] || 0).toFixed(2) })))))))));
}
const RULE_NAME = { '用户口径.md': '写作规矩（每次提意见记下的）', '审稿清单.md': '审稿时逐条对照的清单', '通用检查规则.md': '机器检查的禁用词和规则' };
async function drawRules(box, seq) {
  box.append(el('h3', { style: 'margin-top:0', text: '写作规矩' }),
    el('p', { class: 'note', style: 'margin-top:0', text: '程序写稿、审稿、改稿都照这些来。照意见修改时，以后都要照办的意见会自动记进来，不用手改。点一项看全文。' }));
  const out = box.appendChild(el('div', null, el('p', { class: 'muted', text: '正在读取…' })));
  let d;
  try { d = await api('/api/standards'); }
  catch (e) { if (!stale(seq)) clear(out).appendChild(el('p', { class: 'bad', text: errText(e) })); return; }
  if (stale(seq)) return;
  clear(out);
  const files = (Array.isArray(d['文件']) ? d['文件'] : []).filter((f) => !/^_/.test(String(f['路径'] || '')));
  if (!files.length) { out.appendChild(empty('还没有写作规矩。')); return; }
  const nice = (p) => RULE_NAME[p] || (/^各章要点[\\\/](\d{2})/.test(p) ? '第' + Number(/(\d{2})/.exec(p)[1]) + '章要点（' + (/风险/.test(p) ? '风险评估法' : '写法和常见错误') + '）' : p.replace(/\.md$/, ''));
  out.appendChild(el('div', { class: 'tablewrap' }, el('table', { class: 'list' },
    el('tbody', null, files.map((f) => el('tr', { class: 'click', tabindex: '0', onclick: () => showRule(f, nice(f['路径'])), onkeydown: (e) => { if (e.key === 'Enter') showRule(f, nice(f['路径'])); } },
      el('td', null, el('div', { text: nice(f['路径']) }), el('div', { class: 'note', text: f['路径'] })), el('td', { class: 'num note', text: fmtNum(f['字数'] || 0) + ' 字' }), el('td', { class: 'note', text: '改于 ' + fmtTime(f['修改']) })))))));
}
async function showRule(f, title) {
  const body = el('div', null, el('p', { class: 'muted', text: '正在读取…' }));
  openModal(title, body);
  try {
    const d = await api('/api/file' + q({ '路径': f['完整路径'] }));
    clear(body).append(renderDoc(d['文字'] || '', {}), el('div', { class: 'formbtns' }, el('button', { onclick: () => openPath(d['路径'] || f['完整路径']) }, '在电脑上打开')));
  } catch (e) { if (!DEAD) clear(body).appendChild(el('p', { class: 'bad', text: errText(e) })); }
}

// ---------- 启动 ----------
loadSettings();
route();
/* SCRIPT-END */
</script>
</body>
</html>
